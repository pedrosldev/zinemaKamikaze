{
  "name": "zinemakamikaze",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node post-build.js",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "rm -rf dist .astro && pnpm run build && pm2 restart zinemakamikaze",
    "migrate": "node scripts/migrate.cjs",
    "migrate:prod": "cross-env NODE_ENV=production node scripts/migrate.cjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mts\"",
    "test:db": "cross-env TEST_DB=1 node --experimental-strip-types --test \"tests/**/*.test.mts\"",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/netlify": "8.2.10",
    "@astrojs/node": "11.1.9",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "7.4.4",
    "dotenv": "^16.5.0",
    "mysql2": "^3.14.0",
    "openai": "^4.87.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}