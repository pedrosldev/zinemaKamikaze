---
import { getReviewsByVibe } from "../../lib/db";
import Layout from "../../layouts/Layout.astro";
export const prerender = false;

const vibe = Astro.params.vibe;
const reviews = vibe ? await getReviewsByVibe(vibe) : [];
---

<head>
  <meta charset="utf-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>

<Layout>
  <main class="reviews-layout">
    <!-- Header pantalla completa -->
    <div class="full-width-header">
      <h1>ZINEMA KAMIKAZE: {vibe}</h1>
      <div class="film-grain"></div>
      <div class="old-film-scratches"></div>
      <a href="/" class="back-link">Volver al listado</a>
    </div>

    <!-- Contenedor principal con sidebar y contenido -->
    <div class="main-container">
      <!-- Sidebar ancho -->
      <div class="wide-sidebar">
        <div class="film-grain"></div>
        <div class="old-film-scratches"></div>
      </div>

      <!-- Área de contenido con scroll -->
      <div class="content-scrollable">
        <button class="scroll-arrow scroll-up"> ⬆ </button>
        <ul class="reviews-list">
          {
            reviews.map((review, index) => (
              <li
                class={`review-item ${index % 2 === 0 ? "even" : "odd"}`}
                data-poster-url={review.poster}
              >
                <a href={`/reviews/${review.id}`}>
                  {review.title}{" "}
                  <span class="review-year">
                    {review.year && review.year !== 0 ? `(${review.year})` : ""}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <button class="scroll-arrow scroll-down"> ⬇ </button>
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Estructura principal */
  .reviews-layout {
    margin: 0;
    background-color: #1c3b70;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    font-family: "Sigmar", sans-serif;
  }

  /* Header pantalla completa */
  .full-width-header {
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    position: relative;
    overflow: hidden;
    background-image: linear-gradient(
        to right,
        rgba(107, 63, 47, 0.8) 6px,
        transparent 6px
      ),
      linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      0 0,
      100% 0,
      0 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    padding: 30px;
    animation:
      slideInRight 1.5s ease-out,
      flicker 3s infinite 1.5s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 200px;
    width: 100%;
    z-index: 10;
    /* Sombra baja dell tamaño del main*/
    /* box-shadow: 0 4px 10px rgba(0, 0, 0, 0.8); */
  }

  /* Contenedor principal (sidebar + contenido) */
  .main-container {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* Sidebar ancho */
  .wide-sidebar {
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    position: relative;
    overflow: hidden;
    width: 400px; /* Más ancho que antes */
    min-width: 400px;
    background-image: linear-gradient(
        to right,
        rgba(107, 63, 47, 0.8) 6px,
        transparent 6px
      ),
      linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      0 0,
      100% 0,
      0 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    padding: 20px;
    opacity: 0;
    /* animation: flicker 3s infinite; */
  }

  /* Área de contenido con scroll */
  .content-scrollable {
    overflow-y: scroll;
    flex: 1;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    position: relative;
    background-image: linear-gradient(
        to right,
        rgba(107, 63, 47, 0.8) 6px,
        transparent 6px
      ),
      linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      0 0,
      100% 0,
      0 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    padding: 20px;
    animation: flicker 3s infinite;
  }

  .content-scrollable::-webkit-scrollbar {
    display: none;
  }

  /* Lista de reviews */
  .reviews-list {
    list-style-type: none;
    padding: 0;
    width: 90%;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Items alternados */
  .review-item {
    margin: 15px 0;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    width: 80%;
    position: relative;
  }

  .review-item.even {
    margin-right: auto;
    margin-left: 0;
    text-align: left;
    border-left: 4px solid rgba(107, 63, 47, 0.8);
    border-right: none;
  }

  .review-item.odd {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
    border-right: 4px solid #f5d742;
    border-left: none;
  }

  /* Mantener el resto de estilos igual... */
  .review-item:hover {
    transform: translateX(10px);
    filter: brightness(1.1);
  }

  .review-item a {
    color: white;
    text-decoration: none;
    font-size: 1.2rem;
    display: block;
  }

  .review-year {
    color: #f5d742;
    font-size: 0.9rem;
  }

  .back-link {
    color: #f5d742;
    text-decoration: none;
    margin-top: 10px;
    font-size: 1rem;
    transition: all 0.3s ease;
    position: relative;
    z-index: 10;
  }

  /* Efectos de película y animaciones (mantener igual) */
  .film-grain {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: url("/images/old_photo_texture_bw_by_firesign24_7_d1ni173-414w-2x.jpg");
    background-size: cover;
    opacity: 0.15;
    z-index: 100;
    animation: flickerGrain 10s infinite steps(60);
  }

  .old-film-scratches {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url("/images/old_photo_texture_bw_by_firesign24_7_d1ni173-414w-2x.jpg")
      repeat;
    background-size: cover;
    pointer-events: none;
    mix-blend-mode: lighten;
    z-index: 101;
    animation: scratchesFlicker 7s infinite steps(60);
    opacity: 0.12;
  }
  .scroll-arrow {
    position: sticky;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    font-size: 1.5rem;
    padding: 8px 12px;
    border-radius: 50%;
    z-index: 100;
    cursor: pointer;
    margin: auto;
    display: block;
    transition: background 0.3s;
  }

  .scroll-arrow:hover {
    background: rgba(255, 255, 255, 0.8);
    color: black;
  }

  /* Flecha arriba: fija en la parte superior */
  .scroll-up {
    top: 0;
    margin-top: 5px;
  }

  /* Flecha abajo: fija en la parte inferior */
  .scroll-down {
    bottom: 0;
    margin-bottom: 5px;
  }

  @keyframes flicker {
    0%,
    100% {
      filter: brightness(0.8) contrast(0.9);
    }
    50% {
      filter: brightness(0.9) contrast(1);
    }
    75% {
      filter: brightness(0.85) contrast(1.05);
    }
  }

  @keyframes slideInRight {
    0% {
      transform: translateX(100%);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes flickerGrain {
    0% {
      opacity: 0.1;
      transform: translate(0px, 0px);
    }
    25% {
      opacity: 0.2;
      transform: translate(1px, -1px);
    }
    50% {
      opacity: 0.05;
      transform: translate(-1px, 1px);
    }
    75% {
      opacity: 0.15;
      transform: translate(2px, -2px);
    }
    100% {
      opacity: 0.1;
      transform: translate(0px, 0px);
    }
  }

  @keyframes scratchesFlicker {
    0% {
      opacity: 0.1;
      transform: translate(0, 0) scale(1);
    }
    25% {
      opacity: 0.2;
      transform: translateY(-2px) scale(1.01);
    }
    50% {
      opacity: 0.05;
      transform: translateX(1px) scale(0.99);
    }
    75% {
      opacity: 0.15;
      transform: translate(-2px, 1px) scale(1.02);
    }
    100% {
      opacity: 0.1;
      transform: translate(0, 0) scale(1);
    }
  }
  @keyframes slideInFromTop {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    80% {
      transform: translateY(10px);
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelector(".scroll-up")?.addEventListener("click", () => {
      const container = document.querySelector(".content-scrollable");
      container.scrollBy({ top: -200, behavior: "smooth" });
    });

    document.querySelector(".scroll-down")?.addEventListener("click", () => {
      const container = document.querySelector(".content-scrollable");
      container.scrollBy({ top: 200, behavior: "smooth" });
    });
    document.querySelector("ul").addEventListener("mouseover", (e) => {
      const li = e.target.closest(".review-item");
      const poster = li ? li.dataset.posterUrl : "";
      const posterUrl = `https://image.tmdb.org/t/p/w500${poster}`;
      const sidebar = document.querySelector(".wide-sidebar");
      sidebar.style.backgroundImage = `url(${posterUrl})`;
      sidebar.style.backgroundSize = "cover";
      sidebar.style.backgroundPosition = "center";
      sidebar.style.filter = "brightness(0.8) contrast(0.9)";
      sidebar.style.animation = "none";
      sidebar.offsetHeight; // Trigger reflow
      sidebar.style.animation = "flicker 3s infinite";
    });
    // Animación del header
    const header = document.querySelector(".full-width-header");
    const sidebar = document.querySelector(".wide-sidebar");
    if (header) {
      header.style.animation = "none";
      header.offsetHeight; // Trigger reflow
      header.style.animation = "";
    }

    if (sidebar) {
      sidebar.style.animation = "none";
      sidebar.offsetWidth; // Trigger reflow
      sidebar.style.animation = "slideInFromTop 1.5s";
      // sidebar.style.animationDelay = '1.5s';
      sidebar.style.opacity = "1";
    }

    // Scroll con rueda del mouse
    const scrollContainer = document.querySelector(".content-scrollable");
    if (scrollContainer) {
      scrollContainer.addEventListener("wheel", (e) => {
        e.preventDefault();
        scrollContainer.scrollTop += e.deltaY;
      });
    }
  });
</script>
