---
// src/pages/admin/index.astro
import Layout from "../../layouts/Layout.astro";
import { getActiveTokens, getReviewsWithNullReview } from "../../lib/db";

const authToken = Astro.cookies.get("admin_auth")?.value;
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || "tu-password-segura";

const activeTokens = await getActiveTokens();
const pendingReviews = await getReviewsWithNullReview();

if (authToken !== ADMIN_PASSWORD) {
  return Astro.redirect("/admin/login");
}
---

<Layout>
  <div class="admin-container">
    <div class="logout-container">
      <button id="logoutBtn" class="logout-btn">CERRAR SESIÓN</button>
    </div>
    <h1>ZONA DE ADMINISTRACIÓN - TOKENS</h1>

    <div class="tokens-section">
      <h2>GENERAR NUEVO CÓDIGO</h2>
      <button id="generateToken" class="generate-btn"
        >GENERAR NUEVO CÓDIGO</button
      >

      <div class="active-tokens">
        <h3>CÓDIGOS ACTIVOS:</h3>
        {
          activeTokens.length > 0 ? (
            <div class="tokens-list">
              {activeTokens.map((token) => (
                <div class="token-item">
                  <div class="token-code">
                    <strong>CÓDIGO:</strong>
                    <code>{token.token}</code>
                  </div>
                  <div class="token-info">
                    <strong>CREADO:</strong>{" "}
                    {new Date(token.created_at).toLocaleString()}
                  </div>
                  <div class="token-instructions">
                    <em>
                      Comparte este código con el ganador para que pueda generar
                      una crítica
                    </em>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p>No hay códigos activos</p>
          )
        }
      </div>
    </div>

    <!-- Sección para completar reviews pendientes -->
    <div class="pending-reviews">
      <h2>CRÍTICAS PENDIENTES DE COMPLETAR</h2>
      {
        pendingReviews.length > 0 ? (
          <div class="reviews-list">
            <div class="form-group">
              <label for="selectReview">SELECCIONAR CRÍTICA A COMPLETAR:</label>
              <select id="selectReview" class="review-select">
                <option value="">-- Selecciona una crítica pendiente --</option>
                {pendingReviews.map((review) => (
                  <option
                    value={review.id}
                    data-review={JSON.stringify(review)}
                  >
                    {review.title} ({review.year}) - ID: {review.film_id}
                  </option>
                ))}
              </select>
            </div>
          </div>
        ) : (
          <p>No hay críticas pendientes de completar</p>
        )
      }
    </div>

    <!-- Formulario para completar/actualizar críticas -->
    <div class="review-form" id="updateReviewForm" style="display: none;">
      <h2>COMPLETAR CRÍTICA</h2>
      <form id="reviewForm">
        <input type="hidden" id="review_id" name="id" />

        <div class="form-group">
          <label for="film_id">FILM ID:</label>
          <input type="number" id="film_id" name="film_id" required readonly />
        </div>

        <div class="form-group">
          <label for="title">TÍTULO:</label>
          <input type="text" id="title" name="title" required readonly />
        </div>

        <div class="form-group">
          <label for="year">AÑO:</label>
          <input type="number" id="year" name="year" required readonly />
        </div>

        <div class="form-group">
          <label for="poster">URL DEL PÓSTER:</label>
          <input type="text" id="poster" name="poster" required readonly />
        </div>

        <div class="form-group">
          <label for="vibe">VIBE:</label>
          <select name="vibe" id="vibe" required>
            <option value="eutanasia">EUTANASIA</option>
            <option value="vomito">VOMITO</option>
            <option value="aburrida">ABURRIDA</option>
            <option value="pasable">PASABLE</option>
            <option value="disfrutable">DISFRUTABLE</option>
            <option value="entretenida">ENTRETENIDA</option>
            <option value="mola">MOLA</option>
            <option value="obra maestra">OBRA MAESTRA</option>
          </select>
        </div>

        <div class="form-group">
          <label for="review">CRÍTICA:</label>
          <textarea id="review" name="review" rows="10" required></textarea>
        </div>

        <button type="submit">ACTUALIZAR CRÍTICA</button>
      </form>
    </div>

    <!-- Formulario para nuevas críticas manuales -->
    <div class="review-form">
      <h2>NUEVA CRÍTICA MANUAL</h2>
      <form id="newReviewForm">
        <div class="form-group">
          <label for="new_film_id">FILM ID:</label>
          <input type="number" id="new_film_id" name="film_id" required />
        </div>

        <div class="form-group">
          <label for="new_title">TÍTULO:</label>
          <input type="text" id="new_title" name="title" required />
        </div>

        <div class="form-group">
          <label for="new_year">AÑO:</label>
          <input type="number" id="new_year" name="year" required />
        </div>

        <div class="form-group">
          <label for="new_poster">URL DEL PÓSTER:</label>
          <input type="text" id="new_poster" name="poster"  />
        </div>

        <div class="form-group">
          <label for="new_vibe">VIBE:</label>
          <select name="vibe" id="new_vibe" required>
            <option value="eutanasia">EUTANASIA</option>
            <option value="vomito">VOMITO</option>
            <option value="aburrida">ABURRIDA</option>
            <option value="pasable">PASABLE</option>
            <option value="disfrutable">DISFRUTABLE</option>
            <option value="entretenida">ENTRETENIDA</option>
            <option value="mola">MOLA</option>
            <option value="obra maestra">OBRA MAESTRA</option>
          </select>
        </div>

        <div class="form-group">
          <label for="new_review">CRÍTICA:</label>
          <textarea id="new_review" name="review" rows="10" required></textarea>
        </div>

        <button type="submit">GUARDAR NUEVA CRÍTICA</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .admin-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family: "Sigmar", sans-serif;
    background-color: #1c3b70;
    min-height: 100vh;
  }

  h1,
  h2,
  h3 {
    color: #c9be9c;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
  }

  .tokens-section,
  .review-form,
  .pending-reviews {
    background: rgba(26, 84, 250, 0.1);
    padding: 1.5rem;
    margin-bottom: 2rem;
    border-radius: 8px;
    border: 2px solid rgba(107, 63, 47, 0.8);
    animation: flicker 3s infinite;
  }

  .generate-btn {
    background: #f5d742;
    color: #000;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: "Sigmar", sans-serif;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  .generate-btn:hover {
    background: #d4b82a;
    transform: scale(1.05);
  }

  .token-item {
    background: rgba(26, 26, 24, 0.9);
    padding: 1.5rem;
    margin: 1rem 0;
    border-radius: 8px;
    border: 2px solid rgba(107, 63, 47, 0.8);
    color: #c9be9c;
  }

  .token-code code {
    background: #f1f1f1;
    color: #000;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 1.1rem;
    display: block;
    margin: 0.5rem 0;
    text-align: center;
  }

  .token-info {
    margin: 0.5rem 0;
    font-size: 0.9rem;
  }

  .token-instructions {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(107, 63, 47, 0.5);
    font-style: italic;
    color: #999;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
    color: #c9be9c;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  input,
  textarea,
  select {
    width: 100%;
    padding: 0.75rem;
    border: 2px solid rgba(107, 63, 47, 0.8);
    border-radius: 4px;
    background: rgba(26, 26, 24, 0.9);
    color: #c9be9c;
    font-family: "Sigmar", sans-serif;
    font-size: 1rem;
    box-sizing: border-box;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: #f5d742;
    box-shadow: 0 0 10px rgba(245, 215, 66, 0.3);
  }

  button[type="submit"] {
    background: #1a54fa;
    color: white;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: "Sigmar", sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  button[type="submit"]:hover {
    background: #1540c0;
    transform: scale(1.05);
  }

  .logout-container {
    text-align: right;
    margin-bottom: 1rem;
  }

  .logout-btn {
    background: #f44336;
    color: white;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: "Sigmar", sans-serif;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .logout-btn:hover {
    background: #d32f2f;
  }

  /* Estilos específicos para selects */
  select {
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=US-ASCII,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 4 5'><path fill='%23c9be9c' d='M2 0L0 2h4zm0 5L0 3h4z'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 12px;
    padding-right: 2.5rem;
    transition: all 0.3s ease;
  }

  select:hover {
    border-color: #f5d742;
  }

  select option {
    background: rgba(26, 26, 24, 0.95);
    color: #c9be9c;
    font-family: "Sigmar", sans-serif;
    padding: 0.5rem;
    border: none;
  }

  select option:hover {
    background: #f5d742;
    color: #000;
  }

  /* Para navegadores WebKit (Chrome, Safari) */
  select::-webkit-scrollbar {
    width: 8px;
  }

  select::-webkit-scrollbar-track {
    background: rgba(26, 26, 24, 0.9);
  }

  select::-webkit-scrollbar-thumb {
    background: #f5d742;
    border-radius: 4px;
  }

  select::-webkit-scrollbar-thumb:hover {
    background: #d4b82a;
  }

  /* Estilos para campos readonly */
  input[readonly] {
    background: rgba(107, 63, 47, 0.3) !important;
    color: #999 !important;
    cursor: not-allowed;
  }

  /* Estilos específicos para el select de reviews pendientes */
  .review-select {
    font-size: 1rem;
    border: 2px solid rgba(107, 63, 47, 0.8);
  }

  .review-select:focus {
    border-color: #f5d742;
  }

  /* Animación flicker */
  @keyframes flicker {
    0%,
    100% {
      filter: brightness(0.8) contrast(0.9);
    }
    50% {
      filter: brightness(0.9) contrast(1);
    }
    75% {
      filter: brightness(0.85) contrast(1.05);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .admin-container {
      padding: 1rem;
    }

    .tokens-section,
    .review-form,
    .pending-reviews {
      padding: 1rem;
    }

    h1 {
      font-size: 1.5rem;
    }

    h2 {
      font-size: 1.3rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log("🔄 DOM cargado - Configurando event listeners...");

    const generateTokenBtn = document.getElementById("generateToken");
    const reviewForm = document.getElementById("reviewForm");
    const newReviewForm = document.getElementById("newReviewForm");
    const selectReview = document.getElementById("selectReview");
    const updateReviewForm = document.getElementById("updateReviewForm");

    // Event listener para seleccionar review pendiente
    if (selectReview) {
      selectReview.addEventListener("change", function () {
        const selectedOption = this.options[this.selectedIndex];

        if (selectedOption.value) {
          const reviewData = JSON.parse(selectedOption.dataset.review);
          fillFormWithReviewData(reviewData);
          updateReviewForm.style.display = "block";
        } else {
          updateReviewForm.style.display = "none";
        }
      });
    }

    function fillFormWithReviewData(reviewData) {
      document.getElementById("review_id").value = reviewData.id;
      document.getElementById("film_id").value = reviewData.film_id;
      document.getElementById("title").value = reviewData.title || "";
      document.getElementById("year").value = reviewData.year || "";
      document.getElementById("poster").value = reviewData.poster_url || "";
      document.getElementById("vibe").value = reviewData.vibe || "pasable";
      document.getElementById("review").value = "";
    }

    // Event listener para actualizar review existente
    if (reviewForm) {
      reviewForm.addEventListener("submit", async function (e) {
        e.preventDefault();
        console.log("📝 Formulario de actualización enviado");

        const formData = new FormData(this);
        const reviewData = Object.fromEntries(formData);

        try {
          const response = await fetch("/api/update-review", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(reviewData),
          });

          if (response.ok) {
            alert("CRÍTICA ACTUALIZADA EXITOSAMENTE");
            this.reset();
            updateReviewForm.style.display = "none";
            selectReview.value = "";
            location.reload(); // Recargar para actualizar la lista
          } else {
            const error = await response.json();
            alert(
              "ERROR AL ACTUALIZAR LA CRÍTICA: " +
                (error.message || "Error desconocido")
            );
          }
        } catch (error) {
          console.error("Error:", error);
          alert("ERROR AL ACTUALIZAR LA CRÍTICA");
        }
      });
    }

    // Event listener para nueva review
    if (newReviewForm) {
      newReviewForm.addEventListener("submit", async function (e) {
        e.preventDefault();
        console.log("📝 Formulario nueva review enviado");

        const formData = new FormData(this);
        const reviewData = Object.fromEntries(formData);

        try {
          const response = await fetch("/api/register-review", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(reviewData),
          });

          if (response.ok) {
            alert("CRÍTICA GUARDADA EXITOSAMENTE");
            this.reset();
          } else {
            alert("ERROR AL GUARDAR LA CRÍTICA");
          }
        } catch (error) {
          console.error("Error:", error);
          alert("ERROR AL GUARDAR LA CRÍTICA");
        }
      });
    }

    // Event listener para generar token
    if (generateTokenBtn) {
      generateTokenBtn.addEventListener("click", async function () {
        console.log("🎯 CLICK RECIBIDO en generar token");
        try {
          const button = this;
          button.disabled = true;
          button.textContent = "GENERANDO...";

          const response = await fetch("/api/generate-tokens", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
          });

          const result = await response.json();
          console.log("🎉 Resultado:", result);

          if (response.ok && result.token) {
            alert(
              `NUEVO CÓDIGO GENERADO:\n\n${result.token}\n\nCopia este código y compártelo con el ganador.`
            );
            location.reload();
          } else {
            alert(
              "ERROR AL GENERAR EL CÓDIGO: " +
                (result.message || "Error desconocido")
            );
          }
        } catch (error) {
          console.error("❌ Error completo:", error);
          alert("ERROR DE CONEXIÓN: " + error.message);
        } finally {
          const button = document.getElementById("generateToken");
          if (button) {
            button.disabled = false;
            button.textContent = "GENERAR NUEVO CÓDIGO";
          }
        }
      });
    }

    // Event listener para logout
    document
      .getElementById("logoutBtn")
      ?.addEventListener("click", async () => {
        try {
          await fetch("/api/admin-logout", { method: "POST" });
          window.location.href = "/admin/login";
        } catch (error) {
          console.error("Error al cerrar sesión:", error);
        }
      });
  });
</script>
