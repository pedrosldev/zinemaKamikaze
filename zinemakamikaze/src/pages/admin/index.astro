---
// src/pages/admin/index.astro
import Layout from "../../layouts/Layout.astro";
import { getActiveTokens, createTriggerToken } from "../../lib/db";

const activeTokens = await getActiveTokens();
---

<Layout>
  <div class="admin-container">
    <h1>ZONA DE ADMINISTRACIÓN - TOKENS</h1>

    <div class="tokens-section">
      <h2>GENERAR NUEVO CÓDIGO</h2>
      <button id="generateToken" class="generate-btn"
        >GENERAR NUEVO CÓDIGO</button
      >

      <div class="active-tokens">
        <h3>CÓDIGOS ACTIVOS:</h3>
        {
          activeTokens.length > 0 ? (
            <div class="tokens-list">
              {activeTokens.map((token) => (
                <div class="token-item">
                  <div class="token-code">
                    <strong>CÓDIGO:</strong>
                    <code>{token.token}</code>
                  </div>
                  <div class="token-info">
                    <strong>CREADO:</strong>{" "}
                    {new Date(token.created_at).toLocaleString()}
                  </div>
                  <div class="token-instructions">
                    <em>
                      Comparte este código con el ganador para que pueda generar
                      una crítica
                    </em>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p>No hay códigos activos</p>
          )
        }
      </div>
    </div>

    <!-- Formulario para nuevas críticas manuales -->
    <div class="review-form">
      <h2>NUEVA CRÍTICA MANUAL</h2>
      <form id="reviewForm">
        <div class="form-group">
          <label for="film_id">FILM ID:</label>
          <input type="number" id="film_id" name="film_id" required />
        </div>

        <div class="form-group">
          <label for="title">TÍTULO:</label>
          <input type="text" id="title" name="title" required />
        </div>

        <div class="form-group">
          <label for="year">AÑO:</label>
          <input type="number" id="year" name="year" required />
        </div>

        <div class="form-group">
          <label for="poster">URL DEL PÓSTER:</label>
          <input type="url" id="poster" name="poster" required />
        </div>

        <div class="form-group">
          <label for="vibe">VIBE:</label>
          <input type="text" id="vibe" name="vibe" required />
        </div>

        <div class="form-group">
          <label for="review">CRÍTICA:</label>
          <textarea id="review" name="review" rows="10" required></textarea>
        </div>

        <button type="submit">GUARDAR CRÍTICA</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .admin-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family: "Sigmar", sans-serif;
    background-color: #1c3b70;
    min-height: 100vh;
  }

  h1,
  h2,
  h3 {
    color: #c9be9c;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
  }

  .tokens-section,
  .review-form {
    background: rgba(26, 84, 250, 0.1);
    padding: 1.5rem;
    margin-bottom: 2rem;
    border-radius: 8px;
    border: 2px solid rgba(107, 63, 47, 0.8);
    animation: flicker 3s infinite;
  }

  .generate-btn {
    background: #f5d742;
    color: #000;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: "Sigmar", sans-serif;
    font-size: 1.1rem;
    margin-bottom: 2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  .generate-btn:hover {
    background: #d4b82a;
    transform: scale(1.05);
  }

  .token-item {
    background: rgba(26, 26, 24, 0.9);
    padding: 1.5rem;
    margin: 1rem 0;
    border-radius: 8px;
    border: 2px solid rgba(107, 63, 47, 0.8);
    color: #c9be9c;
  }

  .token-code code {
    background: #f1f1f1;
    color: #000;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 1.1rem;
    display: block;
    margin: 0.5rem 0;
    text-align: center;
  }

  .token-info {
    margin: 0.5rem 0;
    font-size: 0.9rem;
  }

  .token-instructions {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(107, 63, 47, 0.5);
    font-style: italic;
    color: #999;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: bold;
    color: #c9be9c;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 2px solid rgba(107, 63, 47, 0.8);
    border-radius: 4px;
    background: rgba(26, 26, 24, 0.9);
    color: #c9be9c;
    font-family: "Sigmar", sans-serif;
    font-size: 1rem;
    box-sizing: border-box;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: #f5d742;
    box-shadow: 0 0 10px rgba(245, 215, 66, 0.3);
  }

  button[type="submit"] {
    background: #1a54fa;
    color: white;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: "Sigmar", sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
    display: block;
    margin-left: auto;
    margin-right: auto;
  }

  button[type="submit"]:hover {
    background: #1540c0;
    transform: scale(1.05);
  }

  @keyframes flicker {
    0%,
    100% {
      filter: brightness(0.8) contrast(0.9);
    }
    50% {
      filter: brightness(0.9) contrast(1);
    }
    75% {
      filter: brightness(0.85) contrast(1.05);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log("🔄 DOM cargado - Configurando event listeners...");

    const generateTokenBtn = document.getElementById("generateToken");
    const reviewForm = document.getElementById("reviewForm");

    console.log("🔍 Buscando elementos:", {
      generateTokenBtn: !!generateTokenBtn,
      reviewForm: !!reviewForm,
    });

    if (!generateTokenBtn) {
      console.error("❌ No se encontró el botón generateTokenBtn");
      return;
    }

    if (!reviewForm) {
      console.error("❌ No se encontró el formulario reviewForm");
    }

    // Event listener para el botón de generar token
    generateTokenBtn.addEventListener("click", async function () {
      console.log("🎯 CLICK RECIBIDO en generar token");

      try {
        const button = this;
        button.disabled = true;
        button.textContent = "GENERANDO...";

        console.log("📡 Haciendo fetch a /api/generate-tokens...");
        const response = await fetch("/api/generate-tokens", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
        });

        console.log(
          "📨 Respuesta recibida:",
          response.status,
          response.statusText
        );

        const result = await response.json();
        console.log("🎉 Resultado:", result);

        if (response.ok && result.token) {
          alert(
            `NUEVO CÓDIGO GENERADO:\n\n${result.token}\n\nCopia este código y compártelo con el ganador.`
          );
          console.log("🔄 Recargando página...");
          location.reload();
        } else {
          alert(
            "ERROR AL GENERAR EL CÓDIGO: " +
              (result.message || "Error desconocido")
          );
        }
      } catch (error) {
        console.error("❌ Error completo:", error);
        alert("ERROR DE CONEXIÓN: " + error.message);
      } finally {
        const button = document.getElementById("generateToken");
        if (button) {
          button.disabled = false;
          button.textContent = "GENERAR NUEVO CÓDIGO";
        }
      }
    });

    // Event listener para el formulario
    if (reviewForm) {
      reviewForm.addEventListener("submit", async function (e) {
        e.preventDefault();
        console.log("📝 Formulario enviado");

        const formData = new FormData(this);
        const reviewData = Object.fromEntries(formData);

        try {
          const response = await fetch("/api/register-review", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(reviewData),
          });

          if (response.ok) {
            alert("CRÍTICA GUARDADA EXITOSAMENTE");
            this.reset();
          } else {
            alert("ERROR AL GUARDAR LA CRÍTICA");
          }
        } catch (error) {
          console.error("Error:", error);
          alert("ERROR AL GUARDAR LA CRÍTICA");
        }
      });
    }
  });
</script>
