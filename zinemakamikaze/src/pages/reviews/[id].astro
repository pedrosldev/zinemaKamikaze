---
import { getReviewById } from "../../lib/db";
import Layout from "../../layouts/Layout.astro";
export const prerender = false; // Consultar
// const { params } = Astro;
const review = await getReviewById(Number(Astro.params.id));
---

<Layout>
  {
    review ? (
      <>
        <head>
          <meta charset="utf-8" />
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link
            href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
            rel="stylesheet"
          />
        </head>
        <header>
          <h1>
            {review.title}{" "}
            {review.year && review.year !== 0 ? `(${review.year})` : ""}
          </h1>
          <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href={`/vibe/${review.vibe}`}>Volver a {review.vibe}</a>
            <a href="/" class="back-link">
              Volver al listado
            </a>
          </div>
        </header>

        <!-- Contenedor de créditos -->
        <div class="credits-container">
  <div id="credits-text" class="credits-text">
    {review.review.split('\n').map(line => <p>{line}</p>)}
  </div>
</div>

<div style="display: flex; gap: 1rem; justify-content: center;">
  <img
    id="toggle-btn"
    src="/images/pause-square-svgrepo-com.svg"
    alt="Play/Pause"
    onclick="toggleAnimation()"
  />
</div>

<script is:inline>
  let isPaused = false;
  const toggleBtn = document.getElementById('toggle-btn');
  const creditsText = document.getElementById('credits-text');

  function toggleAnimation() {
    if (!creditsText || !toggleBtn) return;
    isPaused = !isPaused;
    creditsText.style.animationPlayState = isPaused ? 'paused' : 'running';
    toggleBtn.src = isPaused
      ? '/images/play-square-svgrepo-com.svg'
      : '/images/pause-square-svgrepo-com.svg';
  }
</script>
      </>
    ) : (
      <p>Review no encontrada</p>
    )
  }
</Layout>

<style>
  header {
    display: flex;
    flex-direction: column;
    align-content: center;
    justify-content: center;
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    animation: flicker 3s infinite;
    height: 20dvh;
        background-image:
                /* Borde izquierdo */
      linear-gradient(to right, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      /* Borde superior */
        linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      /* Borde derecho - posicionado en el lado derecho */
        linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      /* Borde inferior - posicionado en la parte inferior */
        linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      /* Borde izquierdo */ 0 0,
      /* Borde superior */ 100% 0,
      /* Borde derecho */ 0 100%;
    /* Borde inferior */
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
  }
  h1, p, a {
    font-family: "Sigmar", sans-serif;
    text-align: center;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    filter: brightness(0.8);
  }

  img {
    width: 50px;
    height: 50px;
    cursor: pointer;
  }

  .credits-container {
    height: 70dvh;
    overflow: hidden;
    position: relative;
    background-color: black;
    color: white;
    /* margin-top: 2rem; */
    cursor: pointer; /* indica que se puede hacer clic */
  }

  .credits-text {
    display: flex;
    flex-direction: column;
    animation: scroll-up 20s linear infinite;
    animation-play-state: running;
  }

  @keyframes scroll-up {
    0% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(-100%);
    }
  }

    @keyframes flicker {
    0%,
    100% {
      filter: brightness(0.8) contrast(0.9);
    }

    50% {
      filter: brightness(0.9) contrast(1);
    }

    75% {
      filter: brightness(0.85) contrast(1.05);
    }
  }
</style>


