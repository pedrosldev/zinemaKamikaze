---
import { getReviewById } from "../../lib/db";
export const prerender = false; // Consultar
// const { params } = Astro;
const review = await getReviewById(Number(Astro.params.id));
---

{
  review ? (
    <>
      <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
  </head>
      <h1>
        {review.title} ({review.year})
      </h1>
      <p>{review.review}</p>
      <p>
        <strong>Vibe:</strong> {review.vibe}
      </p>

      <a href={`/vibe/${review.vibe}`}>← Volver a {review.vibe}</a>
    </>
  ) : (
    <p>Review no encontrada</p>
  )
}

<style>
  h1 {
    font-family: "Sigmar", sans-serif;
    text-align: center;
  }
  p {
    font-family: "Sigmar", sans-serif;
    text-align: center;
  }
  a {
    font-family: "Sigmar", sans-serif;
    text-decoration: none;
    color: blue;
  }
</style>