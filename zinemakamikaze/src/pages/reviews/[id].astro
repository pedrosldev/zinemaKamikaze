---
import { getReviewById } from "../../lib/db";
import Layout from "../../layouts/Layout.astro";
export const prerender = false; // Consultar
// const { params } = Astro;
const review = await getReviewById(Number(Astro.params.id));
---

<Layout>
  {
    review ? (
      <>
        <head>
          <meta charset="utf-8" />
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link
            href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
            rel="stylesheet"
          />
        </head>
        <header>
          <h1>
            {review.title}{" "}
            {review.year && review.year !== 0 ? `(${review.year})` : ""}
          </h1>
          <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href={`/vibe/${review.vibe}`}>Volver a {review.vibe}</a>
            <a href="/" class="back-link">
              Volver al listado
            </a>
          </div>
        </header>

        <!-- Contenedor de créditos -->
        <div class="credits-container" onclick="toggleAnimation()">
          <div id="credits-text" class="credits-text">
            {review.review.split('\n').map(line => <p>{line}</p>)}
          </div>
        </div>

        <p>
          <strong>Vibe:</strong> {review.vibe}
        </p>

        <script is:inline>
          let isPaused = false;
          function toggleAnimation() {
            const el = document.getElementById('credits-text');
            if (!el) return;
            isPaused = !isPaused;
            el.style.animationPlayState = isPaused ? 'paused' : 'running';
          }
        </script>
      </>
    ) : (
      <p>Review no encontrada</p>
    )
  }
</Layout>

<style>
  header {
    display: flex;
    flex-direction: column;
    align-content: center;
    justify-content: center;
    background-color: grey;
    height: 12vh;
  }
  h1, p, a {
    font-family: "Sigmar", sans-serif;
    text-align: center;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    filter: brightness(0.8);
  }

  .credits-container {
    height: 300px;
    overflow: hidden;
    position: relative;
    background-color: black;
    color: white;
    margin-top: 2rem;
    cursor: pointer; /* indica que se puede hacer clic */
  }

  .credits-text {
    display: flex;
    flex-direction: column;
    animation: scroll-up 20s linear infinite;
    animation-play-state: running;
  }

  @keyframes scroll-up {
    0% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(-100%);
    }
  }
</style>


