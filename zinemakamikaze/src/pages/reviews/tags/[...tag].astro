---
// Importaciones necesarias
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

// getStaticPaths: Genera rutas estáticas para cada tag
export async function getStaticPaths() {
  const reviews = await getCollection("review");

  // Extrae todos los tags únicos
  const allTags = new Set(reviews.flatMap((review) => review.data.tags));

  return Array.from(allTags).map((tag) => ({
    params: { tag },
  }));
}

// Params y filtrado de reviews
const { tag } = Astro.params;
const reviews = await getCollection("review");
const filtered = reviews.filter((review) => review.data.tags.includes(tag));
---

<Layout>
  <h1>Críticas con el tag: {tag}</h1>
  {
    filtered.length > 0 ? (
      <ul>
        {filtered.map((review) => (
          <li>
            <a href={`/reviews/${review.id}`}>{review.data.title}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p>No hay críticas con este tag.</p>
    )
  }
</Layout>
