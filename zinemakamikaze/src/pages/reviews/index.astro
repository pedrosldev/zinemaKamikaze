---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
const reviews = await getCollection("review");
---


  <h1>Críticas de Cine</h1>
  <ul>
    {
      reviews.map((review) => (
        <li>
          <a href={`/reviews/${review.id}`}>{review.data.title}</a>
        </li>
      ))
    }
  </ul>

