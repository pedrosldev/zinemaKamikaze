---
import { type CollectionEntry, getCollection } from "astro:content";
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
export async function getStaticPaths() {
  const reviews = await getCollection("review");
  return reviews.map((review) => ({
    params: { slug: review.data.slug },
    props:  review ,
  }));
}
type Props = CollectionEntry<"review">;

const review = Astro.props as Props;

const { Content } = await render(review);
---

<Layout>
    <h1>{review.data.title}</h1>
    <p>{review.data.date}</p>
    <Content />
    <a href="/reviews">Volver a la lista de críticas</a>
</Layout>