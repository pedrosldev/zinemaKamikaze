---
const left = "ZINEMA KAMIKAZE!";
const right = "";
import { getAllVibes } from "../lib/db";
import Vibrarcodion from "./Vibrarcodion.astro";

const vibes = await getAllVibes();
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>

<main>
  <div class="a">
    <h1>ZINEMA KAMIKAZE!!!</h1><div class="film-grain"></div>
    <div class="old-film-scratches"></div>
  </div>
  <div class="b">Actor 2</div>
  <div class="c">Escena 1</div>
  <div class="d">
    <h1 class="findSurprise" id="btnLeer">Y LA ELEGIDA ES...</h1>
    <div id="contenido"></div>
  </div>
  <div class="e surprise"></div>
  <div class="f">
    <div class="film-grain"></div>
    <div class="old-film-scratches"></div>
    <Vibrarcodion vibes={vibes} />
  </div>
</main>

<style>
  main {
    margin: 0;
    background-color: #1c3b70;
    display: grid;
    grid-template-areas:
      "a b b b c"
      "d e e e f"
      "d e e e f";
    height: 100vh;
    overflow: hidden;
    /* Evitar scroll en el body */
    grid-gap: 0px;
    /* Eliminar espacio entre celdas de la grid */
    font-family: "Sigmar", sans-serif;
  }

  main > div:not(.film-grain):not(.old-film-scratches) {
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: flicker 3s infinite;
    position: relative;
    overflow: hidden;

    /* Aplicamos el efecto de cuadrícula marrón translúcido en los cuatro lados con bordes más finos */
    background-image:
                /* Borde izquierdo */
      linear-gradient(to right, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      /* Borde superior */
        linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      /* Borde derecho - posicionado en el lado derecho */
        linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      /* Borde inferior - posicionado en la parte inferior */
        linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      /* Borde izquierdo */ 0 0,
      /* Borde superior */ 100% 0,
      /* Borde derecho */ 0 100%;
    /* Borde inferior */
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    /* Asegurar que el padding y border no aumenten el tamaño */
  }
  .findSurprise {
    cursor: pointer;
  }
  .a {
    grid-area: a;
  }

  .b {
    grid-area: b;
  }

  .c {
    grid-area: c;
  }

  .d {
    grid-area: d;
  }

  .e {
    grid-area: e;
  }

  .f {
    grid-area: f;
  }

  @keyframes flicker {
    0%,
    100% {
      filter: brightness(0.8) contrast(0.9);
    }

    50% {
      filter: brightness(0.9) contrast(1);
    }

    75% {
      filter: brightness(0.85) contrast(1.05);
    }
  }

  .b > .film-grain,
  .f > .film-grain {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: url("/images/old_celluloid.png");
    background-size: cover;
    opacity: 0.15;
    z-index: 100;
    animation: flickerGrain 10s infinite steps(60);
  }

  .a > .old-film-scratches,
  .f > .old-film-scratches {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url("/images/old_celluloid.png") repeat;
    background-size: cover;
    pointer-events: none;
    mix-blend-mode: lighten;
    z-index: 101;
    animation: scratchesFlicker 7s infinite steps(60);
    opacity: 0.12;
  }
  .d {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @keyframes flickerGrain {
    0% {
      opacity: 0.1;
      transform: translate(0px, 0px);
    }

    25% {
      opacity: 0.2;
      transform: translate(1px, -1px);
    }

    50% {
      opacity: 0.05;
      transform: translate(-1px, 1px);
    }

    75% {
      opacity: 0.15;
      transform: translate(2px, -2px);
    }

    100% {
      opacity: 0.1;
      transform: translate(0px, 0px);
    }
  }

  @keyframes scratchesFlicker {
    0% {
      opacity: 0.1;
      transform: translate(0, 0) scale(1);
    }

    25% {
      opacity: 0.2;
      transform: translateY(-2px) scale(1.01);
    }

    50% {
      opacity: 0.05;
      transform: translateX(1px) scale(0.99);
    }

    75% {
      opacity: 0.15;
      transform: translate(-2px, 1px) scale(1.02);
    }

    100% {
      opacity: 0.1;
      transform: translate(0, 0) scale(1);
    }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btnLeer = document.getElementById("btnLeer");
    const contenidoDiv = document.getElementById("contenido");
    const surpriseDiv = document.querySelector(".surprise")! as HTMLDivElement;

    if (!btnLeer || !contenidoDiv) {
      console.error("❌ Error: No se encontró el botón o el div 'contenido'.");
      return;
    }

    btnLeer.addEventListener("click", function () {
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
      });
      fetch("/api/titles.json")
        .then((response) => {
          if (!response.ok)
            throw new Error("Error al cargar el archivo: " + response.status);
          return response.json();
        })
        .then((data) => {
          if (!Array.isArray(data))
            throw new Error("El JSON no tiene el formato correcto.");

          const randomIndex = Math.floor(Math.random() * data.length);
          const pelicula = data[randomIndex];
          const film = Math.floor(Math.random() * pelicula.films.length);
          const filmId = pelicula.films[film].id;
          const poster = pelicula.films[film].poster_path || "";
          const year = pelicula.films[film].year || "Unknown";
          const title = pelicula.films[film].title;
          console.log(pelicula.films[film].id);

          fetch("/api/register-review", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              film_id: filmId,
              title: title,
              year: year,
              poster: poster,
            }),
          })
            .then((response) => {
              if (!response.ok) {
                throw new Error(
                  "Error al guardar la review en la base de datos."
                );
              }
              return response.json();
            })
            .then((data) => {
              console.log("✅ Review guardada:", data.message);
            })
            .catch((error) => {
              console.error("❌ Error al guardar la review:", error.message);
            });
          if (!poster) {
            //surpriseDiv.innerHTML = `<img src="/images/noImg.jpg" alt="Sin póster disponible" style="width: 30%; height: 20%; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); transition: transform 0.3s ease-in-out; ">`;
            surpriseDiv.style.backgroundImage = `url(/images/noImg.jpg)`;
            surpriseDiv.style.backgroundSize = "100% 100%";
            surpriseDiv.style.backgroundPosition = "center";
            surpriseDiv.style.backgroundRepeat = "no-repeat";
            surpriseDiv.style.filter = "blur(0px)";
          } else {
            const posterUrl = `https://image.tmdb.org/t/p/w500${poster}`;
            // surpriseDiv.innerHTML = `<img src="${posterUrl}" alt="Poster de la película" style="width: 300px; height: 400px; object-fit: contain; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); transition: transform 0.3s ease-in-out; opacity: 0;" loading="lazy" onload="this.style.opacity=1">`;
            surpriseDiv.style.backgroundImage = `url(${posterUrl})`;
            surpriseDiv.style.backgroundSize = "100% 100%";
            surpriseDiv.style.backgroundPosition = "center";
            surpriseDiv.style.backgroundRepeat = "no-repeat";
          }

          contenidoDiv.innerHTML = `<strong>${title} (${year})</strong>`;
        })
        .catch((error) => {
          contenidoDiv.textContent = "Error: " + error.message;
        });
    });
  });
</script>
