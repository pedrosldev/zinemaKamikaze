---
const left = "ZINEMA";
const right = "KAMIKAZE";
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>
<div class="container">
  <div class="left column">
    {left.split("").map((letter) => <span>{letter}</span>)}
  </div>
  <main>
    <h1>Y LA SORPRESA ES...</h1>
    <button id="btnLeer">Cargar archivo.txt</button>

    <h2>Contenido del fichero:</h2>
    <div id="contenido"></div>
    <div class="surprise"></div>
  </main>
  <div class="right column">
    {right.split("").map((letter) => <span>{letter}</span>)}
  </div>
</div>
<style>
  .container {
    font-family: "Sigmar", sans-serif;
    text-align: center;
    display: flex;
    justify-content: space-between;
  }
  .column {
    background-color: grey;
  }
  .left,
  .right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 15%;
    height: 100vh;
    font-size: 3.5rem;
  }
  main {
    display: flex;
    flex-direction: column;
  }
  .surprise {
    width: 700px;
    height: 700px;
    border: solid 1px black;
  }
</style>
<script>
  // document.getElementById("btnLeer").addEventListener("click", function () {
  //   const contenidoDiv = document.getElementById("contenido");

  //   // Ruta al archivo que deseas leer (debe estar en tu servidor)
  //   const rutaArchivo = "/archivo.txt";

  //   // Usar fetch para obtener el contenido del archivo
  //   fetch(rutaArchivo)
  //     .then((response) => {
  //       if (!response.ok) {
  //         throw new Error("Error al cargar el archivo: " + response.status);
  //       }
  //       return response.text();
  //     })
  //     .then((texto) => {
  //       // Mostrar el contenido en el DOM
  //       contenidoDiv.textContent = texto;
  //     })
  //     .catch((error) => {
  //       contenidoDiv.textContent = "Error: " + error.message;
  //     });
  // });
  document.getElementById("btnLeer").addEventListener("click", function () {
    const contenidoDiv = document.getElementById("contenido");

    fetch("/titles.json")
      .then((response) => {
        if (!response.ok) {
          throw new Error("Error al cargar el archivo: " + response.status);
        }
        return response.json(); // Convertimos el JSON en un array
      })
      .then((data) => {
        if (!Array.isArray(data)) {
          throw new Error("El JSON no tiene el formato correcto.");
        }

        // Elegir una película aleatoria
        const pelicula = data[Math.floor(Math.random() * data.length)];

        // Mostrar título y año en el DOM
        contenidoDiv.innerHTML = `<strong>${pelicula.title}</strong> (${pelicula.year ?? "Año desconocido"})`;
      })
      .catch((error) => {
        contenidoDiv.textContent = "Error: " + error.message;
      });
  });
</script>
