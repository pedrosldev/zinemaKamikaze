---
const left = "ZINEMA";
const right = "KAMIKAZE";
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>
<div class="container">
  <div class="left column">
    {left.split("").map((letter) => <span>{letter}</span>)}
  </div>
  <main>
    <h1 class="findSurprise" id="btnLeer">Y LA ELEGIDA ES...</h1>
    <!-- <button id="btnLeer">Cargar archivo.txt</button> -->

    <!-- <h2>Contenido del fichero:</h2> -->
    <div id="contenido"></div>
    <div class="surprise"></div>
  </main>
  <div class="right column">
    {right.split("").map((letter) => <span>{letter}</span>)}
  </div>
</div>
<style>
  .container {
    font-family: "Sigmar", sans-serif;
    text-align: center;
    display: flex;
    justify-content: space-between;
  }
  .column {
    background-color: grey;
  }
  .left,
  .right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 15%;
    height: 100vh;
    font-size: 3.5rem;
  }
  main {
    display: flex;
    flex-direction: column;
  }

  .findSurprise {
    /* font-size: 2rem;
    margin: 0;
    padding: 0; */
    color: white;
    background-color: rgb(0, 0, 0, 0.8);
    padding: 5px;
    border-radius: 5px;
    cursor: pointer;
  }

  .findSurprise:hover {
    background-color: rgb(0, 0, 0, 0.9);
  }
  .surprise {
    margin-top: 10px;
    width: 700px;
    height: 700px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    box-sizing: border-box; /* Asegura que padding no afecta el tamaño total */

    /* overflow-y: scroll; */
    /*border: solid 1px black;*/
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btnLeer = document.getElementById("btnLeer");
    const contenidoDiv = document.getElementById("contenido");
    const surpriseDiv = document.querySelector(".surprise")! as HTMLDivElement;

    if (!btnLeer || !contenidoDiv) {
      console.error("❌ Error: No se encontró el botón o el div 'contenido'.");
      return;
    }

    btnLeer.addEventListener("click", function () {
      fetch("/all_titles.json")
        .then((response) => {
          if (!response.ok)
            throw new Error("Error al cargar el archivo: " + response.status);
          return response.json();
        })
        .then((data) => {
          if (!Array.isArray(data))
            throw new Error("El JSON no tiene el formato correcto.");

          const randomIndex = Math.floor(Math.random() * data.length);
          const pelicula = data[randomIndex];
          const film = Math.floor(Math.random() * pelicula.films.length);
          const poster = pelicula.films[film].poster_path;
          const year = pelicula.films[film].year;
          const title = pelicula.films[film].title;

          if (!poster) {
            // console.log("No hay poster");

            surpriseDiv.innerHTML = `<img src="/images/noImg.jpg" alt="Sin póster disponible" >`;
            // surpriseDiv.style.backgroundImage = `url(/images/noImg.jpg)`;
            // surpriseDiv.style.backgroundSize = "cover";
            // surpriseDiv.style.backgroundRepeat = "no-repeat";
            // surpriseDiv.style.backgroundPosition = "center";
          } else {
            const posterUrl = `https://image.tmdb.org/t/p/w500${poster}`;
            surpriseDiv.innerHTML = `<img src="${posterUrl}" alt="Poster de la película">`;
            // surpriseDiv.style.backgroundImage = `url(${posterUrl})`;
            // surpriseDiv.style.backgroundSize = "contain";
            // surpriseDiv.style.backgroundRepeat = "no-repeat";
            // surpriseDiv.style.backgroundPosition = "center";
            // surpriseDiv.style.borderRadius = "20px";
            // surpriseDiv.style.overflow = "hidden"; // si fuera necesario
            // surpriseDiv.style.width = "300px"; // o lo que necesites
            // surpriseDiv.style.height = "450px"; // para mantener proporción
            // surpriseDiv.style.width = "100%";
            // surpriseDiv.style.height = "100%";
            // surpriseDiv.style.borderRadius = "10px";
            // surpriseDiv.style.boxShadow = "0 4px 8px rgba(0, 0, 0, 0.2)";
            // surpriseDiv.style.transition = "transform 0.3s ease-in-out";
          }

          contenidoDiv.innerHTML = `<strong>${title} (${year})</strong>`;
        })
        .catch((error) => {
          contenidoDiv.textContent = "Error: " + error.message;
        });
    });
  });
</script>
