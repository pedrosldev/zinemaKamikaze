---
const left = "ZINEMA KAMIKAZE";
const right = "";
import { getAllVibes } from '../lib/db';

const vibes = await getAllVibes();
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>
<div class="container">
  <div class="left column">
    {left.split("").map((letter) => <span>{letter}</span>)}
  </div>
  <ul>
    {vibes.map(vibe => (
      <li><a href={`/vibe/${vibe}`}>{vibe}</a></li>
    ))}
  </ul>
  <main>
    <h1 class="findSurprise" id="btnLeer">Y LA ELEGIDA ES...</h1>

    <div id="contenido"></div>
    <div class="surprise"></div>
  </main>
  <!-- <div class="right column">
    <!-- <a href="/reviews" class="btn-enlace">Ver todas las críticas</a>
    <a href="/reviews/tags">Buscar por etiquetas</a> -->
</div> 

<style>
  .container {
    font-family: "Sigmar", sans-serif;
    text-align: center;
    display: flex;
    flex-direction: column;

    /* align-items: center; */
  }
  .column {
    background-color: grey;
  }
  .left,
  .right {
    /* display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center; */
    /* width: 15%; */
    height: 10vh;
    font-size: 2rem;
  }
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .findSurprise {
    color: white;
    background-color: rgb(0, 0, 0, 0.8);
    padding: 5px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: lighter;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  .findSurprise:hover {
    background-color: rgb(0, 0, 0, 0.9);
  }
  .surprise {
    margin-top: 10px;

    box-sizing: border-box;
  }

  ul{
    list-style-type: none;
    padding: 0;
    margin: 10px;
    display: flex;
    /* flex-direction: column; */
    align-items: center;
    justify-content: space-around;
  }

  ul li a {
    text-decoration: none;
    color: white;
    background-color: rgb(0, 0, 0, 0.8);
    padding: 3px;
    border-radius: 5px;
    font-size: 1.2rem;
    font-weight: lighter;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s ease-in-out;
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const btnLeer = document.getElementById("btnLeer");
    const contenidoDiv = document.getElementById("contenido");
    const surpriseDiv = document.querySelector(".surprise")! as HTMLDivElement;

    if (!btnLeer || !contenidoDiv) {
      console.error("❌ Error: No se encontró el botón o el div 'contenido'.");
      return;
    }

    btnLeer.addEventListener("click", function () {
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
      });
      fetch("/api/titles.json")
        .then((response) => {
          if (!response.ok)
            throw new Error("Error al cargar el archivo: " + response.status);
          return response.json();
        })
        .then((data) => {
          if (!Array.isArray(data))
            throw new Error("El JSON no tiene el formato correcto.");

          const randomIndex = Math.floor(Math.random() * data.length);
          const pelicula = data[randomIndex];
          const film = Math.floor(Math.random() * pelicula.films.length);
          const filmId = pelicula.films[film].id;
          const poster = pelicula.films[film].poster_path;
          const year = pelicula.films[film].year || "Unknown";
          const title = pelicula.films[film].title;
          console.log(pelicula.films[film].id);
           fetch("/api/register-review", {
             method: "POST",
             headers: {
               "Content-Type": "application/json",
             },
             body: JSON.stringify({ film_id: filmId, title: title, year: year }),
           })
             .then((response) => {
               if (!response.ok) {
                 throw new Error(
                   "Error al guardar la review en la base de datos."
                 );
               }
               return response.json();
             })
             .then((data) => {
               console.log("✅ Review guardada:", data.message);
             })
             .catch((error) => {
               console.error("❌ Error al guardar la review:", error.message);
             });
          if (!poster) {
            surpriseDiv.innerHTML = `<img src="/images/noImg.jpg" alt="Sin póster disponible" style="width: 30%; height: 20%; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); transition: transform 0.3s ease-in-out; ">`;
          } else {
            const posterUrl = `https://image.tmdb.org/t/p/w500${poster}`;
            surpriseDiv.innerHTML = `<img src="${posterUrl}" alt="Poster de la película" style="width: 80%; height: 80%; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); transition: transform 0.3s ease-in-out; opacity: 0;" loading="lazy" onload="this.style.opacity=1">`;
          }

          contenidoDiv.innerHTML = `<strong>${title} (${year})</strong>`;
        })
        .catch((error) => {
          contenidoDiv.textContent = "Error: " + error.message;
        });
    });
  });
</script>
