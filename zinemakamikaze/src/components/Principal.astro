---
const left = "ZINEMA";
const right = "KAMIKAZE";
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>
<div class="container">
  <div class="left column">
    {left.split("").map((letter) => <span>{letter}</span>)}
  </div>
  <main>
    <h1>Y LA SORPRESA ES...</h1>
    <button id="btnLeer">Cargar archivo.txt</button>

    <h2>Contenido del fichero:</h2>
    <div id="contenido"></div>
    <div class="surprise"></div>
  </main>
  <div class="right column">
    {right.split("").map((letter) => <span>{letter}</span>)}
  </div>
</div>
<style>
  .container {
    font-family: "Sigmar", sans-serif;
    text-align: center;
    display: flex;
    justify-content: space-between;
  }
  .column {
    background-color: grey;
  }
  .left,
  .right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 15%;
    height: 100vh;
    font-size: 3.5rem;
  }
  main {
    display: flex;
    flex-direction: column;
  }
  .surprise {
    width: 700px;
    height: 700px;
    /*border: solid 1px black;*/
  }
</style>
<script>
  const TMDB_API_KEY =
    "eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiI4MDdiOTAzODhhNmZkYzhmNjg1ZTQ3NDA3YTIxYWYwNiIsIm5iZiI6MTcwMzcwNTA3OS41NDcwMDAyLCJzdWIiOiI2NThjNzlmN2YzYjQ5YTI1M2U0MDNjNzIiLCJzY29wZXMiOlsiYXBpX3JlYWQiXSwidmVyc2lvbiI6MX0.lfReehtY6PH2LHirD2oAquddfvs-eP8c4vp-WtqElQ0";
  let filmSearch = "";
  document.addEventListener("DOMContentLoaded", function () {
    const btnLeer = document.getElementById("btnLeer");
    const contenidoDiv = document.getElementById("contenido");
    const surpriseDiv = document.querySelector(".surprise");

    if (!btnLeer || !contenidoDiv) {
      console.error("❌ Error: No se encontró el botón o el div 'contenido'.");
      return;
    }

    btnLeer.addEventListener("click", function () {
      console.log(TMDB_API_KEY);
      fetch("/titles.json")
        .then((response) => {
          if (!response.ok)
            throw new Error("Error al cargar el archivo: " + response.status);
          return response.json();
        })
        .then((data) => {
          if (!Array.isArray(data))
            throw new Error("El JSON no tiene el formato correcto.");

          const pelicula = data[Math.floor(Math.random() * data.length)];
          filmSearch = pelicula.title;
          contenidoDiv.innerHTML = `<strong>${pelicula.title}</strong> (${pelicula.year ?? "Año desconocido"})`;
          return fetch(
            `https://api.themoviedb.org/3/search/movie?query=${encodeURIComponent(
              filmSearch
            )}`,
            {
              headers: { Authorization: `Bearer ${TMDB_API_KEY}` },
            }
          )
            .then((response) => {
              if (!response.ok)
                throw new Error(
                  "Error al cargar el archivo: " + response.status
                );
              return response.json();
            })
            .then((data) => {
              let posterUrl = "";
              if (!filmSearch) {
                contenidoDiv.textContent =
                  "Error: No se ha encontrado la película";
                posterUrl = "/images/noImg.jpg";
              }

              console.log("FIlm", filmSearch);
              console.log(data);
              // console.log(data.results[0].poster_path);

              if (data.results.length > 1) {
                console.log("MÄS DE UNA PELÍCULA");
              }
              console.log("Tamaño", data.results.length);
              if (data.results.length === 0 || !data.results[0].poster_path) {
                console.log("No hay poster");
                posterUrl = "/images/noImg.jpg";
              } else {
                posterUrl = `https://image.tmdb.org/t/p/w500${data.results[0].poster_path}`;
              }

              surpriseDiv.innerHTML = `<img src="${posterUrl}" alt="Poster de la película" style="width:100%; height:100%;">`;
              // if (!Array.isArray(data))
              //   throw new Error("El JSON no tiene el formato correcto.");

              // const pelicula = data[Math.floor(Math.random() * data.length)];
              // contenidoDiv.innerHTML = `<strong>${pelicula.title}</strong> (${pelicula.year ?? "Año desconocido"})`;
            })
            .catch((error) => {
              // contenidoDiv.textContent = "Error: " + error.message;
              console.error("Error: " + error.message);
            });
        })
        .catch((error) => {
          contenidoDiv.textContent = "Error: " + error.message;
        });
    });
  });
</script>
