</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const tokenInput = document.getElementById(
      "tokenInput"
    ) as HTMLInputElement;
    const validateTokenBtn = document.getElementById(
      "validateToken"
    ) as HTMLButtonElement;
    const tokenMessage = document.getElementById(
      "tokenMessage"
    ) as HTMLParagraphElement;
    const tokenContainer = document.getElementById(
      "tokenContainer"
    ) as HTMLDivElement;
    const btnLeer = document.getElementById("btnLeer") as HTMLButtonElement;
    const contenidoDiv = document.getElementById("contenido") as HTMLDivElement;
    const surpriseDiv = document.querySelector(".surprise") as HTMLDivElement;

    // Verificar que todos los elementos existen
    if (
      !tokenInput ||
      !validateTokenBtn ||
      !tokenMessage ||
      !tokenContainer ||
      !btnLeer ||
      !contenidoDiv ||
      !surpriseDiv
    ) {
      console.error("❌ Error: No se encontraron algunos elementos del DOM");
      return;
    }

    // Función para generar la película
    function generateMovie() {
      confetti({
        particleCount: 100,
        spread: 70,
        origin: { y: 0.6 },
      });

      fetch("/api/titles.json")
        .then((response) => {
          if (!response.ok)
            throw new Error("Error al cargar el archivo: " + response.status);
          return response.json();
        })
        .then((data) => {
          if (!Array.isArray(data))
            throw new Error("El JSON no tiene el formato correcto.");

          const randomIndex = Math.floor(Math.random() * data.length);
          const pelicula = data[randomIndex];
          const film = Math.floor(Math.random() * pelicula.films.length);
          const filmId = pelicula.films[film].id;
          const poster = pelicula.films[film].poster_path || "";
          const year = pelicula.films[film].year || "Unknown";
          const review = null;
          const vibe = null;
          const title = pelicula.films[film].title;
          console.log(pelicula.films[film].id);

          fetch("/api/register-review", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              film_id: filmId,
              title: title,
              year: year,
              review: review,
              vibe: vibe,
              poster: poster,
            }),
          })
            .then((response) => {
              if (!response.ok) {
                throw new Error(
                  "Error al guardar la review en la base de datos."
                );
              }
              return response.json();
            })
            .then((data) => {
              console.log("✅ Review guardada:", data.message);
            })
            .catch((error) => {
              console.error("❌ Error al guardar la review:", error.message);
            });

          if (!poster) {
            surpriseDiv!.style.backgroundImage = `url(/images/noImg.jpg)`;
            surpriseDiv!.style.backgroundSize = "100% 100%";
            surpriseDiv!.style.backgroundPosition = "center";
            surpriseDiv!.style.backgroundRepeat = "no-repeat";
            surpriseDiv!.style.filter = "blur(0px)";
          } else {
            const posterUrl = `https://image.tmdb.org/t/p/w500${poster}`;
            surpriseDiv!.style.backgroundImage = `url(${posterUrl})`;
            surpriseDiv!.style.backgroundSize = "100% 100%";
            surpriseDiv!.style.backgroundPosition = "center";
            surpriseDiv!.style.backgroundRepeat = "no-repeat";
          }

          contenidoDiv!.innerHTML = `<strong>${title} (${year})</strong>`;

          setTimeout(() => {
            window.location.reload();
          }, 3000);
        })
        .catch((error) => {
          contenidoDiv!.textContent = "Error: " + error.message;
        });
    }

    // Función para validar el token
    async function validateToken(token: string) {
      try {
        validateTokenBtn!.disabled = true;
        validateTokenBtn!.textContent = "VALIDANDO...";
        tokenMessage!.textContent = "";
        tokenMessage!.className = "token-message";

        const response = await fetch("/api/validate-tokens", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ token: token.trim() }),
        });

        const result = await response.json();

        if (response.ok && result.valid) {
          // Token válido - ocultar contenedor y generar película directamente
          tokenMessage!.textContent = "¡CÓDIGO VÁLIDO! Generando película...";
          tokenMessage!.className = "token-message token-success";
          tokenContainer!.style.display = "none";

          // Efecto de confeti para validación exitosa
          confetti({
            particleCount: 50,
            spread: 70,
            origin: { y: 0.6 },
          });

          // Generar la película directamente después de una breve pausa
          setTimeout(() => {
            generateMovie();
          }, 500);
        } else {
          // Token inválido
          tokenMessage!.textContent =
            result.message || "CÓDIGO INVÁLIDO. Inténtalo de nuevo.";
          tokenMessage!.className = "token-message token-error";
        }
      } catch (error) {
        console.error("Error al validar el token:", error);
        tokenMessage!.textContent = "ERROR DE CONEXIÓN. Inténtalo más tarde.";
        tokenMessage!.className = "token-message token-error";
      } finally {
        validateTokenBtn!.disabled = false;
        validateTokenBtn!.textContent = "VALIDAR CÓDIGO";
      }
    }

    // Event listener para el botón de validar
    validateTokenBtn!.addEventListener("click", function () {
      const token = tokenInput!.value.trim();
      if (!token) {
        tokenMessage!.textContent = "POR FAVOR, INTRODUCE UN CÓDIGO.";
        tokenMessage!.className = "token-message token-error";
        return;
      }
      validateToken(token);
    });

    // También validar al presionar Enter
    tokenInput!.addEventListener("keypress", function (e) {
      if (e.key === "Enter") {
        const token = tokenInput!.value.trim();
        if (token) {
          validateToken(token);
        }
      }
    });

    // Función para generar la crítica (mantener por si acaso)
    btnLeer!.addEventListener("click", function () {
      generateMovie();
    });
  });

  // Evento para el clic en .c - Popup explicativo
  document.addEventListener("DOMContentLoaded", function () {
    const cElement = document.querySelector(".c") as HTMLDivElement;

    if (cElement) {
      cElement.style.cursor = "pointer"; // Cambiar cursor para indicar que es clickeable

      cElement.addEventListener("click", function () {
        // Crear el overlay del popup
        const popupOverlay = document.createElement("div");
        popupOverlay.style.cssText = `
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.8);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 10000;
                backdrop-filter: blur(5px);
            `;

        // Crear el contenido del popup
        const popupContent = document.createElement("div");
        popupContent.style.cssText = `
                background: linear-gradient(135deg, #1a1a18 0%, #2b2317 100%);
                border: 3px solid rgba(107, 63, 47, 0.8);
                border-radius: 8px;
                padding: 2rem;
                max-width: 600px;
                max-height: 80vh;
                overflow-y: auto;
                color: #c9be9c;
                font-family: 'Sigmar', sans-serif;
                position: relative;
                box-shadow: 0 0 30px rgba(245, 215, 66, 0.3);
                text-align: left;
                line-height: 1.6;
            `;

        // Añadir el texto
        popupContent.innerHTML = `
                <h2 style="color: #f5d742; text-align: center; margin-bottom: 1.5rem; text-transform: uppercase; letter-spacing: 2px; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
                    ¿QUÉ ES ZINEMA KAMIKAZE?
                </h2>
                <div style="font-size: 1.1rem;">
                    <p style="margin-bottom: 1rem;"><strong>Es darte la posibilidad de hacer sufrir al menda.</strong></p>
                    <p style="margin-bottom: 1rem;">Pero quizás también de hacerle descubrir una joya oculta.</p>
                    <p style="margin-bottom: 1rem;">Es, al fin y al cabo, dar la posibilidad al usuario de incrementar mi conocimiento audiovisual tanto para bien como para mal.</p>
                    <p style="margin-bottom: 1rem;">Pero el criterio para la selección no es otro más que el puro azar.</p>
                    <p style="margin-bottom: 1rem;">Un algoritmo se encarga de seleccionar un artefacto (puede ser un documental, un corto, un videoclip, ¡lo que sea!) entre una lista de más de 10000 títulos.</p>
                    <p style="margin-bottom: 1rem;">Cada cierto tiempo otorgaré un código a un usuario con el cual disparará el evento que ejecute la ruleta rusa.</p>
                    <p style="margin-bottom: 0;"><strong>Una vez vista, escribiré una crítica que, ya lo adelanto, no será ni sesuda ni técnica.</strong></p>
                </div>
                <button id="closePopup" style="
                    background: #f5d742;
                    color: #000;
                    border: none;
                    padding: 10px 25px;
                    border-radius: 4px;
                    cursor: pointer;
                    font-family: 'Sigmar', sans-serif;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                    margin-top: 1.5rem;
                    display: block;
                    margin-left: auto;
                    margin-right: auto;
                    transition: all 0.3s ease;
                ">ENTENDIDO</button>
            `;

        // Añadir efectos de grano de película al popup
        const filmGrain = document.createElement("div");
        filmGrain.style.cssText = `
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
                background: url("/images/old_celluloid.png");
                background-size: cover;
                opacity: 0.1;
                border-radius: 5px;
            `;

        popupContent.appendChild(filmGrain);
        popupOverlay.appendChild(popupContent);
        document.body.appendChild(popupOverlay);

       

        // Función para cerrar el popup
        function closePopup() {
          document.body.removeChild(popupOverlay);
        }

        // Cerrar al hacer clic en el botón
        const closeButton = document.getElementById("closePopup");
        closeButton?.addEventListener("click", closePopup);

        // Cerrar al hacer clic fuera del contenido
        popupOverlay.addEventListener("click", function (e) {
          if (e.target === popupOverlay) {
            closePopup();
          }
        });

        // Cerrar con la tecla Escape
        document.addEventListener("keydown", function closeOnEscape(e) {
          if (e.key === "Escape") {
            closePopup();
            document.removeEventListener("keydown", closeOnEscape);
          }
        });
      });

      // Efecto hover para .c
      cElement.addEventListener("mouseenter", function () {
        this.style.filter = "brightness(1.1) contrast(1.1)";
        this.style.transform = "scale(1.02)";
        this.style.transition = "all 0.3s ease";
      });

      cElement.addEventListener("mouseleave", function () {
        this.style.filter = "brightness(0.8) contrast(0.9)";
        this.style.transform = "scale(1)";
      });
    }
  });

  // Popup de Moviola - dinámico como el popup de .c
  document.addEventListener("DOMContentLoaded", function () {
    const flipbookTrigger = document.getElementById("flipbookTrigger");

    if (flipbookTrigger) {
      flipbookTrigger.style.cursor = "pointer";

      flipbookTrigger.addEventListener("click", function () {
        // Crear el overlay del popup
        const popupOverlay = document.createElement("div");
        popupOverlay.style.cssText = `
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: rgba(0, 0, 0, 0.85);
          display: flex;
          justify-content: center;
          align-items: center;
          z-index: 9999;
          backdrop-filter: blur(5px);
        `;

        // Crear el contenido del popup
        const popupContent = document.createElement("div");
        popupContent.style.cssText = `
          position: relative;
          width: 90%;
          max-width: 700px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 15px;
          padding: 20px;
        `;

        // Crear el botón de cerrar
        const closeButton = document.createElement("button");
        closeButton.textContent = "CERRAR";
        closeButton.style.cssText = `
          position: fixed;
          top: 20px;
          right: 20px;
          background: #f5d742;
          color: #000;
          border: none;
          padding: 12px 20px;
          border-radius: 4px;
          cursor: pointer;
          font-family: 'Sigmar', sans-serif;
          font-weight: bold;
          text-transform: uppercase;
          letter-spacing: 1px;
          transition: all 0.3s ease;
          z-index: 10001;
          box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        `;

        // Crear el flipbook frame
        const flipbookFrame = document.createElement("div");
        flipbookFrame.style.cssText = `
          width: 100%;
          max-width: 600px;
          aspect-ratio: 16 / 9;
          background: #0a0a0a;
          border: 4px solid rgba(107, 63, 47, 0.9);
          position: relative;
          overflow: hidden;
          box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.9), 0 5px 20px rgba(0, 0, 0, 0.7);
          border-radius: 2px;
        `;

        const flipbookImages = document.createElement("div");
        flipbookImages.style.cssText = `
          width: 100%;
          height: 100%;
          position: relative;
        `;
        
        // Añadir las imágenes del flipbook
        const images = [
          '/images/cartoon/frame1.png',
          '/images/cartoon/frame2.png',
          '/images/cartoon/frame3.png',
          '/images/cartoon/frame2.png',
          '/images/cartoon/frame1.png'
        ];

        images.forEach((src, index) => {
          const img = document.createElement("div");
          img.className = "flipbook-image";
          img.style.cssText = `
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: 110% 110%;
            background-position: center;
            background-repeat: no-repeat;
            background-image: url(${src});
            opacity: 0;
            filter: brightness(0.85) contrast(1.2) saturate(0.8) sepia(0.2);
            animation: fastFlipbook 0.8s infinite;
            animation-delay: ${index * 0.16}s;
          `;
          flipbookImages.appendChild(img);
        });

        // Añadir efecto de parpadeo
        const flickerOverlay = document.createElement("div");
        flickerOverlay.style.cssText = `
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background: radial-gradient(ellipse at center, transparent 30%, rgba(0, 0, 0, 0.3) 100%);
          pointer-events: none;
          z-index: 5;
          animation: projectorFlicker 1s ease-in-out infinite;
        `;

        flipbookFrame.appendChild(flipbookImages);
        flipbookFrame.appendChild(flickerOverlay);

        // Crear los controles de moviola (fuera del frame)
        const controls = document.createElement("div");
        controls.style.cssText = `
          background: rgba(26, 26, 24, 0.95);
          padding: 8px 12px;
          border: 2px solid rgba(107, 63, 47, 0.8);
          border-radius: 6px;
          backdrop-filter: blur(10px);
          min-width: 200px;
          max-width: 220px;
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        `;
        
        controls.innerHTML = `
          <div style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;">
            <label for="speedControlPopup" style="color: #f5d742; font-family: 'Sigmar', sans-serif; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8); width: 100%; text-align: center; margin-bottom: 4px;">VELOCIDAD MOVIOLA</label>
            <div style="display: flex; justify-content: center; align-items: center;">
              <input
                type="range"
                id="speedControlPopup"
                style="width: 150px; height: 5px; background: rgba(107, 63, 47, 0.6); border-radius: 3px; outline: none; -webkit-appearance: none; margin-right: 5px;"
                min="0.1"
                max="2"
                step="0.1"
                value="1.0"
              />
              <div style="display: flex; align-items: center;">
                <span style="color: #c9be9c; font-family: 'Sigmar', sans-serif; font-size: 0.7rem; font-weight: bold; background: rgba(0, 0, 0, 0.5); padding: 1px 6px; border-radius: 8px; border: 1px solid rgba(245, 215, 66, 0.3); line-height: 1; display: inline-block;">1.0x</span>
              </div>
            </div>
          </div>
        `;

        // Ensamblar el popup
        popupContent.appendChild(flipbookFrame);
        popupContent.appendChild(controls);
        popupOverlay.appendChild(closeButton);
        popupOverlay.appendChild(popupContent);
        document.body.appendChild(popupOverlay);

        // Función para cerrar el popup
        function closePopup() {
          document.body.removeChild(popupOverlay);
        }

        // Cerrar al hacer clic en el botón
        closeButton.addEventListener("click", closePopup);

        // Cerrar al hacer clic fuera del contenido
        popupOverlay.addEventListener("click", function (e) {
          if (e.target === popupOverlay) {
            closePopup();
          }
        });

        // Cerrar con la tecla Escape
        document.addEventListener("keydown", function closeOnEscape(e) {
          if (e.key === "Escape") {
            closePopup();
            document.removeEventListener("keydown", closeOnEscape);
          }
        });

        // Inicializar controles de velocidad para este popup
        const speedControlPopup = document.getElementById("speedControlPopup") as HTMLInputElement;
        const speedValuePopup = controls.querySelector("span") as HTMLSpanElement;
        const flipbookImagesPopup = flipbookImages.querySelectorAll(".flipbook-image") as NodeListOf<HTMLElement>;

        // Agregar estilos CSS para el thumb del slider
        const style = document.createElement('style');
        style.textContent = `
          #speedControlPopup::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: #f5d742;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #000;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
          }
          #speedControlPopup::-webkit-slider-thumb:hover {
            background: #d4b82a;
            transform: scale(1.1);
          }
          #speedControlPopup::-moz-range-thumb {
            width: 16px;
            height: 16px;
            background: #f5d742;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #000;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
          }
          #speedControlPopup:active {
            transform: scale(1.02);
          }
        `;
        document.head.appendChild(style);

        function updateSpeedPopup() {
          if (!speedControlPopup || !speedValuePopup || flipbookImagesPopup.length === 0) return;

          const speed = parseFloat(speedControlPopup.value);
          speedValuePopup.textContent = `${speed.toFixed(1)}x`;

          const baseDuration = 0.8;
          const newDuration = baseDuration / speed;

          flipbookImagesPopup.forEach((img, index) => {
            img.style.animationDuration = `${newDuration}s`;
            const delayPerFrame = newDuration / 5;
            img.style.animationDelay = `${delayPerFrame * index}s`;
          });
        }

        if (speedControlPopup && speedValuePopup && flipbookImagesPopup.length > 0) {
          speedControlPopup.addEventListener("input", updateSpeedPopup);
          updateSpeedPopup();
        }

        // Hover effect en el botón cerrar
        closeButton.addEventListener("mouseenter", function() {
          this.style.background = "#d4b82a";
          this.style.transform = "scale(1.05)";
          this.style.boxShadow = "0 6px 15px rgba(0, 0, 0, 0.7)";
        });

        closeButton.addEventListener("mouseleave", function() {
          this.style.background = "#f5d742";
          this.style.transform = "scale(1)";
          this.style.boxShadow = "0 4px 10px rgba(0, 0, 0, 0.5)";
        });
      });
    }
  });


</script>
