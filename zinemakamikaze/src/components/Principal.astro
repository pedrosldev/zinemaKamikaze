---
const left = "ZINEMA";
const right = "KAMIKAZE";
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>
<div class="container">
  <div class="left column">
    {left.split("").map((letter) => <span>{letter}</span>)}
  </div>
  <main>
    <h1>Y LA SORPRESA ES...</h1>
    <div class="surprise"></div>
  </main>
  <div class="right column">
    {right.split("").map((letter) => <span>{letter}</span>)}
  </div>
</div>
<style>
  .container {
    font-family: "Sigmar", sans-serif;
    text-align: center;
    display: flex;
    justify-content: space-between;
  }
  .column {
    background-color: grey;
  }
  .left,
  .right {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 15%;
    height: 100vh;
    font-size: 3.5rem;
  }
  main {
    display: flex;
    flex-direction: column;
  }
  .surprise {
    width: 700px;
    height: 700px;
    border: solid 1px black;
  }
</style>
