---
// Página de prueba para catalogUtils.ts
import { getAllMovies, getMoviesForPage, getTotalPages } from '../lib/catalogUtils';

const allMovies = getAllMovies();
const totalPages = getTotalPages(100);
const firstPage = getMoviesForPage(1, 100);
const lastPage = getMoviesForPage(totalPages, 100);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test - Catalog Utils</title>
  <style>
    body {
      font-family: monospace;
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
      background: #000;
      color: #0f0;
    }
    h1 { color: #0ff; }
    h2 { color: #ff0; margin-top: 30px; }
    pre {
      background: #111;
      padding: 15px;
      border-radius: 5px;
      overflow-x: auto;
    }
    .success { color: #0f0; }
    .info { color: #fff; }
  </style>
</head>
<body>
  <h1>🎬 Pruebas de catalogUtils.ts</h1>

  <h2 class="success">✅ Total de películas</h2>
  <pre>Total: {allMovies.length}
Primera: "{allMovies[0].title}" ({allMovies[0].year})
Última: "{allMovies[allMovies.length - 1].title}" ({allMovies[allMovies.length - 1].year})</pre>

  <h2 class="success">✅ Total de páginas (100 por página)</h2>
  <pre>Páginas: {totalPages}</pre>

  <h2 class="success">✅ Primera página</h2>
  <pre>Películas en página: {firstPage.movies.length}
Página actual: {firstPage.currentPage}
Total de páginas: {firstPage.totalPages}
Total de películas: {firstPage.totalMovies}

Primeras 5 películas:
{firstPage.movies.slice(0, 5).map((m, i) => `${i + 1}. "${m.title}" (${m.year}) - ID: ${m.id}`).join('\n')}</pre>

  <h2 class="success">✅ Última página ({totalPages})</h2>
  <pre>Películas en página: {lastPage.movies.length}

Primeras 5 películas de la última página:
{lastPage.movies.slice(0, 5).map((m, i) => `${i + 1}. "${m.title}" (${m.year}) - ID: ${m.id}`).join('\n')}</pre>

  <h2 class="info">📊 Estadísticas</h2>
  <pre>Total de películas: {allMovies.length}
Películas por página: 100
Total de páginas: {totalPages}
Películas en última página: {lastPage.movies.length}

Cálculo: {allMovies.length} películas ÷ 100 = {totalPages} páginas
Verificación: {(totalPages - 1) * 100 + lastPage.movies.length} películas total ✓</pre>

  <h2 class="success">🎉 Todas las pruebas completadas!</h2>
  <p><a href="/" style="color: #0ff;">← Volver al inicio</a></p>
</body>
</html>
