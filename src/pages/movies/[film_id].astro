---
import MovieLayout from "../../layouts/MovieLayout.astro";
import MovieHeader from "../../components/movies/MovieHeader.astro";
import MovieReviewCard from "../../components/movies/MovieReviewCard.astro";
import { getReviewsByFilmId } from "../../lib/db";
import { getAllMovies } from "../../lib/catalogUtils";

// SSR para evitar timeout en Netlify (25,947 páginas exceden el límite de 18 min)
export const prerender = false;

const filmId = Number(Astro.params.film_id);
const reviews = await getReviewsByFilmId(filmId);

// Buscar info básica de la película en el catálogo
const allMovies = getAllMovies();
const movieInfo = allMovies.find(m => m.id === filmId);

if (!movieInfo) {
  return Astro.redirect("/404");
}

const hasReviews = reviews && reviews.length > 0;
const movie = hasReviews ? reviews[0] : movieInfo;
---

<MovieLayout title={`${movie.title} - Zinema Kamikaze`}>
  <div 
    class="movie-page-wrapper" 
    data-has-poster={movieInfo.poster_path ? 'true' : 'false'} 
    style={movieInfo.poster_path ? `--poster-url: url(https://image.tmdb.org/t/p/w780${movieInfo.poster_path})` : ''}
  >
    <MovieHeader
      title={movie.title}
      year={movie.year}
      viewingCount={reviews.length}
      hasReviews={hasReviews}
    />

    <main class="reviews-timeline">
      {hasReviews ? (
        reviews.map((review, index) => (
          <MovieReviewCard review={review} index={index} />
        ))
      ) : (
        <div class="no-reviews-message">
          <p>📽️ Esta película aún no ha sido vista</p>
          <p class="movie-overview">{movieInfo.overview || "Sin descripción disponible."}</p>
        </div>
      )}
    </main>
  </div>
</MovieLayout>
