---
// src/pages/admin/index.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getActiveTokens, getReviewsWithNullReview } from "../../lib/db";
import TokenManagement from "../../components/admin/TokenManagement.astro";
import SelectionModeToggle from "../../components/admin/SelectionModeToggle.astro";
import PendingReviewsSelector from "../../components/admin/PendingReviewsSelector.astro";
import ReviewForm from "../../components/admin/ReviewForm.astro";
import NewReviewForm from "../../components/admin/NewReviewForm.astro";

// El middleware ya redirige, pero no consultamos la BD hasta comprobarlo.
if (!Astro.locals.adminAuthenticated) {
  return Astro.redirect("/admin/login");
}

const activeTokens = await getActiveTokens();
const pendingReviews = await getReviewsWithNullReview();
---

<AdminLayout title="Administración - Zinema Kamikaze">
  <div class="admin-container">
    <div class="logout-container">
      <button id="logoutBtn" class="logout-btn">CERRAR SESIÓN</button>
    </div>
    <h1>ZONA DE ADMINISTRACIÓN - TOKENS</h1>

    <SelectionModeToggle />

    <TokenManagement activeTokens={activeTokens} />

    <PendingReviewsSelector pendingReviews={pendingReviews} />

    <ReviewForm />

    <NewReviewForm />
  </div>
</AdminLayout>

<script>
  import { initAdminPanel } from '../../scripts/admin/adminPanel';

  document.addEventListener("DOMContentLoaded", () => {
    initAdminPanel();
  });
</script>
