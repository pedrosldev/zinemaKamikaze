---
import AdminLayout from "../../layouts/AdminLayout.astro";
import LoginForm from "../../components/admin/LoginForm.astro";

// Si ya está autenticado, redirigir al panel.
if (Astro.locals.adminAuthenticated) {
  return Astro.redirect("/admin");
}
---

<AdminLayout title="Login Admin - Zinema Kamikaze">
  <LoginForm />
</AdminLayout>

<script>
  import { initAdminLogin } from '../../scripts/admin/auth';

  // Inicializar el formulario de login cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    initAdminLogin();
  });
</script>
