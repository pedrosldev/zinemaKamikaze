---
import Layout from "../../layouts/Layout.astro";

// Si ya está autenticado, redirigir al admin
const authToken = Astro.cookies.get("admin_auth")?.value;
const ADMIN_PASSWORD = import.meta.env.ADMIN_PASSWORD || "tu-password-segura";

if (authToken === ADMIN_PASSWORD) {
  return Astro.redirect("/admin");
}
---

<Layout>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
      rel="stylesheet"
    />
  </head>
  <div class="login-container">
    <a href="/">Inicio</a>
    <h1>ACCESO ADMINISTRATIVO</h1>

    <form id="loginForm">
      <div class="form-group">
        <label for="password">CONTRASEÑA:</label>
        <input
          type="password"
          id="password"
          name="password"
          required
          autocomplete="current-password"
        />
      </div>

      <button type="submit">ENTRAR</button>
      <p id="errorMessage" class="error-message"></p>
    </form>
  </div>
</Layout>

<style>
  a{
    color: #c9be9c;
    text-decoration: none;
    font-family: "Special Elite", cursive;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    display: inline-block;
  }
  .login-container {
    max-width: 400px;
    margin: 100px auto;
    padding: 2rem;
    font-family: "Special Elite", cursive;
    background-color: #1c3b70;
    min-height: 50vh;
  }

  h1 {
    color: #c9be9c;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-align: center;
    margin-bottom: 2rem;
    font-family: "Special Elite", cursive;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    color: #c9be9c;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: "Special Elite", cursive;
  }

  input {
    width: 100%;
    padding: 0.75rem;
    border: 2px solid rgba(107, 63, 47, 0.8);
    border-radius: 4px;
    background: rgba(26, 26, 24, 0.9);
    color: #c9be9c;
    font-family: "Special Elite", cursive;
    font-size: 1rem;
    box-sizing: border-box;
  }

  input::placeholder {
    font-family: "Special Elite", cursive;
  }

  input:focus {
    outline: none;
    border-color: #f5d742;
    box-shadow: 0 0 10px rgba(245, 215, 66, 0.3);
  }

  button {
    width: 100%;
    background: #f5d742;
    color: #000;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-family: "Special Elite", cursive;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: bold;
  }

  button:hover {
    background: #d4b82a;
    transform: scale(1.05);
  }

  button:disabled {
    background: #666;
    cursor: not-allowed;
    transform: none;
  }

  .error-message {
    font-family: "Special Elite", cursive;
    color: #f44336;
    text-align: center;
    margin-top: 1rem;
    font-weight: bold;
  }

  /* Añade estas media queries al final de tu <style> */

  /* Tablets y pantallas medianas (hasta 1024px) */
  @media screen and (max-width: 1024px) {
    .login-container {
      max-width: 450px;
      margin: 80px auto;
      padding: 2rem;
    }

    h1 {
      font-size: 1.5rem;
    }

    input {
      font-size: 0.95rem;
    }

    button {
      font-size: 1rem;
      padding: 0.9rem 1.8rem;
    }
  }

  /* Tablets pequeños (hasta 768px) */
  @media screen and (max-width: 768px) {
    .login-container {
      max-width: 90%;
      margin: 60px auto;
      padding: 1.75rem;
      min-height: 45vh;
    }

    h1 {
      font-size: 1.3rem;
      letter-spacing: 1.5px;
      margin-bottom: 1.5rem;
    }

    .form-group {
      margin-bottom: 1.25rem;
    }

    label {
      font-size: 0.9rem;
      margin-bottom: 0.4rem;
    }

    input {
      padding: 0.7rem;
      font-size: 0.9rem;
    }

    button {
      padding: 0.85rem 1.5rem;
      font-size: 0.95rem;
    }

    .error-message {
      font-size: 0.9rem;
    }
  }

  /* Móviles (hasta 480px) */
  @media screen and (max-width: 480px) {
    .login-container {
      max-width: 95%;
      margin: 40px auto;
      padding: 1.5rem;
      min-height: 40vh;
    }

    h1 {
      font-size: 1.1rem;
      letter-spacing: 1px;
      margin-bottom: 1.25rem;
      line-height: 1.3;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    label {
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
      letter-spacing: 0.5px;
    }

    input {
      padding: 0.65rem;
      font-size: 16px; /* Mínimo 16px para evitar zoom en iOS */
      border-width: 2px;
    }

    button {
      padding: 0.8rem 1.25rem;
      font-size: 0.9rem;
      letter-spacing: 0.5px;
    }

    .error-message {
      font-size: 0.85rem;
      margin-top: 0.85rem;
    }
  }

  /* Móviles muy pequeños (hasta 360px) */
  @media screen and (max-width: 360px) {
    .login-container {
      margin: 30px auto;
      padding: 1.25rem;
    }

    h1 {
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    label {
      font-size: 0.8rem;
    }

    input {
      padding: 0.6rem;
      font-size: 16px;
    }

    button {
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
    }

    .error-message {
      font-size: 0.8rem;
    }
  }

  /* Landscape en móviles */
  @media screen and (max-width: 896px) and (orientation: landscape) {
    .login-container {
      max-width: 500px;
      margin: 30px auto;
      padding: 1.5rem;
      min-height: auto;
    }

    h1 {
      font-size: 1.2rem;
      margin-bottom: 1rem;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    input {
      padding: 0.65rem;
    }

    button {
      padding: 0.75rem 1.5rem;
    }
  }

  /* Ajustes visuales para móviles */
  @media screen and (max-width: 768px) {
    /* Mejorar área de toque para inputs */
    input {
      min-height: 44px; /* Tamaño mínimo recomendado para touch */
    }

    button {
      min-height: 48px; /* Botón táctil estándar */
      transition: all 0.3s ease;
    }

    /* Eliminar zoom en hover en móviles */
    button:hover {
      transform: scale(1.02);
    }

    /* Mejorar feedback visual */
    input:focus {
      box-shadow: 0 0 8px rgba(245, 215, 66, 0.4);
    }

    /* Ajuste para teclados virtuales */
    .login-container {
      margin-bottom: 40px;
    }
  }

  /* Soporte para pantallas con notch (iPhone X+) */
  @supports (padding: max(0px)) {
    @media screen and (max-width: 768px) {
      .login-container {
        margin-left: max(20px, env(safe-area-inset-left));
        margin-right: max(20px, env(safe-area-inset-right));
        padding-top: max(1.5rem, env(safe-area-inset-top));
        padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
      }
    }
  }

  /* Estados de carga y error mejorados para móvil */
  @media screen and (max-width: 768px) {
    button:disabled {
      opacity: 0.7;
    }

    .error-message {
      padding: 0.5rem;
      border-radius: 4px;
      background-color: rgba(244, 67, 54, 0.1);
      border-left: 3px solid #f44336;
    }
  }

  /* Optimización de rendimiento para móviles */
  @media screen and (max-width: 768px) {
    /* Prevenir comportamiento extraño con zoom en iOS */
    input,
    button {
      -webkit-appearance: none;
      -moz-appearance: none;
      appearance: none;
    }

    /* Mejorar renderizado */
    .login-container {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Optimizar transiciones */
    button,
    input {
      will-change: transform;
    }
  }

  /* Ajuste para pantallas muy altas (modo portrait en tablets) */
  @media screen and (min-height: 900px) and (max-width: 768px) {
    .login-container {
      margin: 120px auto;
    }
  }

  /* Ajuste para pantallas muy cortas */
  @media screen and (max-height: 600px) {
    .login-container {
      margin: 20px auto;
      padding: 1rem;
      min-height: auto;
    }

    h1 {
      margin-bottom: 1rem;
    }

    .form-group {
      margin-bottom: 0.75rem;
    }
  }
</style>

<script>
  document
    .getElementById("loginForm")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const form = e.target as HTMLFormElement;
      const password = (form.querySelector("#password") as HTMLInputElement)
        .value;
      const errorMessage = document.getElementById("errorMessage");
      const submitBtn = form.querySelector(
        "button[type='submit']"
      ) as HTMLButtonElement;

      if (!errorMessage || !submitBtn) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "VERIFICANDO...";
      errorMessage.textContent = "";

      try {
        const response = await fetch("/api/admin-login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          window.location.href = "/admin";
        } else {
          errorMessage.textContent = "CONTRASEÑA INCORRECTA";
        }
      } catch (error) {
        console.error("Error:", error);
        errorMessage.textContent = "ERROR DE CONEXIÓN";
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "ENTRAR";
      }
    });
</script>
