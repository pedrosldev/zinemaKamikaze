---
import { getReviewsByVibe } from "../../lib/db";
import Layout from "../../layouts/Layout.astro";
export const prerender = false;

const vibe = Astro.params.vibe;
const reviews = vibe ? await getReviewsByVibe(vibe) : [];
---

<head>
  <meta charset="utf-8" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link
    href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
    rel="stylesheet"
  />
</head>

<Layout>
  <main class="reviews-layout">
    <!-- Header pantalla completa -->
    <div class="full-width-header">
      <h1>ZINEMA KAMIKAZE: {vibe}</h1>
      <div class="film-grain"></div>
      <div class="old-film-scratches"></div>
      <a href="/" class="back-link">Volver al listado</a>
    </div>

    <!-- Contenedor principal con sidebar y contenido -->
    <div class="main-container">
      <!-- Sidebar ancho -->
      <div class="wide-sidebar">
        <div class="film-grain"></div>
        <div class="old-film-scratches"></div>
      </div>

      <!-- Área de contenido con scroll -->
      <div class="content-scrollable">
        <!-- <button class="scroll-arrow scroll-up"> ⬆ </button> -->
        <img
          src="/images/caret-circle-up-svgrepo-com.svg"
          alt="Scroll Up"
          class="scroll-arrow scroll-up"
        />
        <ul class="reviews-list">
          {
            reviews.map((review, index) => (
              <li
                class={`review-item ${index % 2 === 0 ? "even" : "odd"}`}
                data-poster-url={review.poster}
              >
                <a href={`/reviews/${review.id}`}>
                  {review.title}{" "}
                  <span class="review-year">
                    {review.year && review.year !== 0 ? `(${review.year})` : ""}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <!-- <button class="scroll-arrow scroll-down"> ⬇ </button> -->
        <img
          src="/images/caret-circle-down-svgrepo-com.svg"
          alt="Scroll Down"
          class="scroll-arrow scroll-down"
        />
      </div>
    </div>
    <div id="mobile-tip" class="mobile-toast">
      Pulsa otra vez para leer la crítica
    </div>
  </main>
</Layout>

<style>
  .mobile-toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    /* Empieza centrado pero oculto bajo la pantalla */
    transform: translateX(-50%) translateY(150px);
    background: #f5d742; /* Tu amarillo */
    color: #1c3b70; /* Tu azul oscuro */
    padding: 12px 24px;
    border-radius: 50px;
    font-size: 0.9rem;
    font-family: "Sigmar", sans-serif;
    font-weight: bold;
    z-index: 2000;
    /* Transición suave con efecto rebote */
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
    display: none; /* Invisible en escritorio */
  }

  /* Se activa solo al añadir esta clase con JS */
  .mobile-toast.visible {
    transform: translateX(-50%) translateY(0);
  }
  /* Estructura principal */
  .reviews-layout {
    margin: 0;
    background-color: #1c3b70;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    font-family: "Sigmar", sans-serif;
  }

  /* img {
    width: 30px;
    height: 30px;
    
  } */
  .full-width-header {
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    position: relative;
    overflow: hidden;
    background-image:
      linear-gradient(to right, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      0 0,
      100% 0,
      0 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    padding: 30px;
    animation:
      slideInRight 1.5s ease-out,
      flicker 3s infinite 1.5s;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 200px;
    width: 100%;
    z-index: 10;
    /* Sombra baja dell tamaño del main*/
    /* box-shadow: 0 4px 10px rgba(0, 0, 0, 0.8); */
  }

  /* Contenedor principal (sidebar + contenido) */
  .main-container {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* Sidebar ancho */
  .wide-sidebar {
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    position: relative;
    overflow: hidden;
    width: 400px; /* Más ancho que antes */
    min-width: 400px;
    background-image:
      linear-gradient(to right, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      0 0,
      100% 0,
      0 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    padding: 20px;
    opacity: 0;
    transition:
      background-image 0.5s ease-in-out,
      opacity 0.5s ease;
    /* animation: flicker 3s infinite; */
  }

  /* Área de contenido con scroll */
  .content-scrollable {
    position: relative;
    overflow-y: scroll;
    flex: 1;
    scrollbar-width: none;
    -ms-overflow-style: none;
    background-color: #1a54fa;
    filter: brightness(0.8) contrast(0.9);
    position: relative;
    background-image:
      linear-gradient(to right, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to bottom, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to left, rgba(107, 63, 47, 0.8) 6px, transparent 6px),
      linear-gradient(to top, rgba(107, 63, 47, 0.8) 6px, transparent 6px);
    background-position:
      0 0,
      0 0,
      100% 0,
      0 100%;
    background-size: 100% 100%;
    background-repeat: no-repeat;
    box-sizing: border-box;
    padding: 20px;
    animation: flicker 3s infinite;
  }

  .content-scrollable::-webkit-scrollbar {
    display: none;
  }

  /* Lista de reviews */
  .reviews-list {
    list-style-type: none;
    padding: 0;
    width: 90%;
    max-width: 1000px;
    margin: 0 auto;
  }

  /* Items alternados */
  .review-item {
    margin: 15px 0;
    padding: 15px;
    background-color: rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
    width: 80%;
    position: relative;
  }

  .review-item.even {
    margin-right: auto;
    margin-left: 0;
    text-align: left;
    border-left: 4px solid rgba(107, 63, 47, 0.8);
    border-right: none;
  }

  .review-item.odd {
    margin-left: auto;
    margin-right: 0;
    text-align: right;
    border-right: 4px solid #f5d742;
    border-left: none;
  }

  /* Mantener el resto de estilos igual... */
  .review-item:hover {
    transform: translateX(10px);
    filter: brightness(1.1);
  }

  .review-item a {
    color: white;
    text-decoration: none;
    font-size: 1.2rem;
    display: block;
  }

  .review-year {
    color: #f5d742;
    font-size: 0.9rem;
  }

  .back-link {
    color: #f5d742;
    text-decoration: none;
    margin-top: 10px;
    font-size: 1rem;
    transition: all 0.3s ease;
    position: relative;
    z-index: 10;
  }

  /* Efectos de película y animaciones (mantener igual) */
  .film-grain {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    background: url("/images/old_photo_texture_bw_by_firesign24_7_d1ni173-414w-2x.jpg");
    background-size: cover;
    opacity: 0.15;
    z-index: 100;
    animation: flickerGrain 10s infinite steps(60);
  }

  .old-film-scratches {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url("/images/old_photo_texture_bw_by_firesign24_7_d1ni173-414w-2x.jpg")
      repeat;
    background-size: cover;
    pointer-events: none;
    mix-blend-mode: lighten;
    z-index: 101;
    animation: scratchesFlicker 7s infinite steps(60);
    opacity: 0.12;
  }
  .scroll-arrow {
    position: sticky;
    /* background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none; */
    /* font-size: 1.5rem;
    padding: 8px 12px;
    border-radius: 50%; */
    z-index: 100;
    cursor: pointer;
    margin: auto;
    display: block;
    transition: background 0.3s;
    width: 30px;
    height: 30px;
  }

  /* .scroll-arrow:hover {
    background: rgba(255, 255, 255, 0.8);
    color: black;
  } */

  /* Flecha arriba: fija en la parte superior */
  .scroll-up {
    top: 0;
    margin-top: 5px;
  }

  /* Flecha abajo: fija en la parte inferior */
  .scroll-down {
    bottom: 0;
    margin-bottom: 5px;
  }

  @keyframes flicker {
    0%,
    100% {
      filter: brightness(0.8) contrast(0.9);
    }
    50% {
      filter: brightness(0.9) contrast(1);
    }
    75% {
      filter: brightness(0.85) contrast(1.05);
    }
  }

  @keyframes slideInRight {
    0% {
      transform: translateX(100%);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes flickerGrain {
    0% {
      opacity: 0.1;
      transform: translate(0px, 0px);
    }
    25% {
      opacity: 0.2;
      transform: translate(1px, -1px);
    }
    50% {
      opacity: 0.05;
      transform: translate(-1px, 1px);
    }
    75% {
      opacity: 0.15;
      transform: translate(2px, -2px);
    }
    100% {
      opacity: 0.1;
      transform: translate(0px, 0px);
    }
  }

  @keyframes scratchesFlicker {
    0% {
      opacity: 0.1;
      transform: translate(0, 0) scale(1);
    }
    25% {
      opacity: 0.2;
      transform: translateY(-2px) scale(1.01);
    }
    50% {
      opacity: 0.05;
      transform: translateX(1px) scale(0.99);
    }
    75% {
      opacity: 0.15;
      transform: translate(-2px, 1px) scale(1.02);
    }
    100% {
      opacity: 0.1;
      transform: translate(0, 0) scale(1);
    }
  }
  @keyframes slideInFromTop {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    80% {
      transform: translateY(10px);
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }
  /* Añade estas media queries al final de tu <style> */

  /* Tablets y pantallas medianas (hasta 1024px) */
  @media screen and (max-width: 1024px) {
    .full-width-header {
      min-height: 150px;
      padding: 20px;
    }

    .full-width-header h1 {
      font-size: 1.8rem;
    }

    .wide-sidebar {
      width: 250px;
      min-width: 250px;
      padding: 15px;
    }

    .reviews-list {
      width: 95%;
    }

    .review-item {
      width: 85%;
      padding: 12px;
    }

    .review-item a {
      font-size: 1.1rem;
    }

    .back-link {
      font-size: 0.9rem;
    }
  }

  /* Tablets pequeños (hasta 768px) */
  @media screen and (max-width: 768px) {
    .reviews-layout {
      height: auto;
      min-height: 100vh;
    }

    .full-width-header {
      min-height: 120px;
      padding: 15px;
    }

    .full-width-header h1 {
      font-size: 1.4rem;
      line-height: 1.3;
    }

    .main-container {
      flex-direction: column;
    }

    /* Sidebar se convierte en header de imagen */
    .wide-sidebar {
      width: 100%;
      min-width: 100%;
      height: 250px;
      min-height: 250px;
      padding: 0;
      order: 1;
    }

    .content-scrollable {
      order: 2;
      height: auto;
      min-height: 400px;
      overflow-y: visible;
      padding: 15px;
    }

    .reviews-list {
      width: 100%;
    }

    /* Eliminar el patrón alternado en móvil */
    .review-item {
      width: 100%;
      margin: 10px 0;
      text-align: left;
      border-left: 4px solid rgba(107, 63, 47, 0.8);
      border-right: none;
    }

    .review-item.odd {
      margin-left: 0;
      margin-right: 0;
      text-align: left;
      border-right: none;
      border-left: 4px solid #f5d742;
    }

    .review-item:hover {
      transform: translateX(5px);
    }

    .review-item a {
      font-size: 1rem;
    }

    .review-year {
      font-size: 0.85rem;
    }

    .back-link {
      font-size: 0.85rem;
      margin-top: 8px;
    }

    /* Flechas de scroll más pequeñas */
    .scroll-arrow {
      width: 25px;
      height: 25px;
    }

    .scroll-up {
      margin-top: 3px;
    }

    .scroll-down {
      margin-bottom: 3px;
    }

    .mobile-toast {
      display: block; /* Solo lo activamos en móviles/tablets */
    }
  }

  /* Móviles (hasta 480px) */
  @media screen and (max-width: 480px) {
    .full-width-header {
      min-height: 100px;
      padding: 12px;
    }

    .full-width-header h1 {
      font-size: 1.1rem;
      line-height: 1.2;
    }

    .wide-sidebar {
      height: 200px;
      min-height: 200px;
    }

    .content-scrollable {
      padding: 10px;
      min-height: 300px;
    }

    .review-item {
      padding: 10px;
      margin: 8px 0;
      border-width: 3px;
    }

    .review-item a {
      font-size: 0.9rem;
    }

    .review-year {
      font-size: 0.75rem;
      display: block;
      margin-top: 4px;
    }

    .back-link {
      font-size: 0.75rem;
    }

    .scroll-arrow {
      width: 20px;
      height: 20px;
    }
  }

  /* Landscape en móviles y tablets */
  @media screen and (max-width: 896px) and (orientation: landscape) {
    .reviews-layout {
      height: auto;
    }

    .full-width-header {
      min-height: 80px;
      padding: 10px;
    }

    .full-width-header h1 {
      font-size: 1.2rem;
    }

    .main-container {
      flex-direction: row;
      min-height: calc(100vh - 80px);
    }

    .wide-sidebar {
      width: 200px;
      min-width: 200px;
      height: auto;
      order: 0;
    }

    .content-scrollable {
      order: 1;
      overflow-y: scroll;
      height: calc(100vh - 80px);
    }

    .reviews-list {
      width: 90%;
    }

    .review-item {
      width: 90%;
    }
  }

  /* Ajustes para efectos visuales en móviles */
  @media screen and (max-width: 768px) {
    /* Reducir intensidad de animaciones en móviles */
    @keyframes flicker {
      0%,
      100% {
        filter: brightness(0.85) contrast(0.95);
      }
      50% {
        filter: brightness(0.9) contrast(1);
      }
    }

    .film-grain,
    .old-film-scratches {
      opacity: 0.08;
    }

    /* Bordes más sutiles en móviles */
    .full-width-header,
    .wide-sidebar,
    .content-scrollable {
      background-image:
        linear-gradient(to right, rgba(107, 63, 47, 0.6) 4px, transparent 4px),
        linear-gradient(to bottom, rgba(107, 63, 47, 0.6) 4px, transparent 4px),
        linear-gradient(to left, rgba(107, 63, 47, 0.6) 4px, transparent 4px),
        linear-gradient(to top, rgba(107, 63, 47, 0.6) 4px, transparent 4px);
    }

    /* Mejorar toque en móviles */
    .review-item a {
      padding: 5px 0;
      display: inline-block;
      width: 100%;
    }

    .back-link {
      padding: 8px 12px;
      display: inline-block;
    }
  }

  /* Muy pequeños (hasta 360px) */
  @media screen and (max-width: 360px) {
    .full-width-header h1 {
      font-size: 1rem;
    }

    .wide-sidebar {
      height: 150px;
      min-height: 150px;
    }

    .review-item a {
      font-size: 0.85rem;
    }

    .back-link {
      font-size: 0.7rem;
    }
  }

  /* Prevenir problemas de scroll en iOS */
  @media screen and (max-width: 768px) {
    .content-scrollable {
      -webkit-overflow-scrolling: touch;
    }

    /* Asegurar que el contenido sea accesible */
    .reviews-list {
      padding-bottom: 20px;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.querySelector(".wide-sidebar");
    const scrollContainer = document.querySelector(".content-scrollable");
    const header = document.querySelector(".full-width-header");

    // 1. Función para actualizar la imagen (Reutilizable)
    const updateSidebar = (poster) => {
      if (!poster || !sidebar) return;
      const posterUrl = `https://image.tmdb.org/t/p/w500${poster}`;
      sidebar.style.backgroundImage = `url(${posterUrl})`;
      sidebar.style.backgroundSize = "cover";
      sidebar.style.backgroundPosition = "center";
      sidebar.style.filter = "brightness(0.8) contrast(0.9)";
      sidebar.style.opacity = "1";
      // Reiniciamos la animación de flicker para que el cartel nuevo también parpadee
      sidebar.style.animation = "none";
      sidebar.offsetHeight; // Trigger reflow
      sidebar.style.animation = "flicker 3s infinite";
    };

    // 2. Evento Mouseover (Escritorio)
    document
      .querySelector(".reviews-list")
      .addEventListener("mouseover", (e) => {
        const li = e.target.closest(".review-item");
        if (li) updateSidebar(li.dataset.posterUrl);
      });

    const mobileTip = document.getElementById("mobile-tip");

    // 3. Evento Click mejorado (Móvil + Tablet)
    document.querySelectorAll(".review-item").forEach((item) => {
      item.addEventListener("click", function (e) {
        if (window.innerWidth <= 768) {
          const poster = this.dataset.posterUrl;

          if (sidebar.getAttribute("data-current-poster") !== poster) {
            e.preventDefault();
            updateSidebar(poster);
            sidebar.setAttribute("data-current-poster", poster);

            // Mostrar el aviso visual
            mobileTip.classList.add("visible");

            // Ocultar el aviso después de 3 segundos
            setTimeout(() => {
              mobileTip.classList.remove("visible");
            }, 3000);

            // Feedback visual en el item
            document
              .querySelectorAll(".review-item")
              .forEach((el) => (el.style.filter = "brightness(1)"));
            this.style.filter = "brightness(1.5) contrast(1.1)";
          } else {
            // Si ya era el actual, al navegar ocultamos el tip por si acaso
            mobileTip.classList.remove("visible");
          }
        }
      });
    });

    // 4. Flechas de Scroll (Tu código original)
    document.querySelector(".scroll-up")?.addEventListener("click", () => {
      scrollContainer.scrollBy({ top: -200, behavior: "smooth" });
    });

    document.querySelector(".scroll-down")?.addEventListener("click", () => {
      scrollContainer.scrollBy({ top: 200, behavior: "smooth" });
    });

    // 5. Animaciones de carga (Tu código original mejorado)
    if (header) {
      header.style.animation = "none";
      header.offsetHeight;
      header.style.animation = "";
    }
    if (sidebar) {
      sidebar.style.animation = "none";
      sidebar.offsetWidth;
      sidebar.style.animation = "slideInFromTop 1.5s";
      sidebar.style.opacity = "1";
    }

    // 6. Scroll con rueda (Tu código original)
    if (scrollContainer) {
      scrollContainer.addEventListener("wheel", (e) => {
        e.preventDefault();
        scrollContainer.scrollTop += e.deltaY;
      });
    }
  });
</script>
