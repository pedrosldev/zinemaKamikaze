---
import { getReviewsByVibe } from "../../lib/db";
import Layout from "../../layouts/Layout.astro";
import VibeHeader from "../../components/vibe/VibeHeader.astro";
import VibeSidebar from "../../components/vibe/VibeSidebar.astro";
import VibeReviewsList from "../../components/vibe/VibeReviewsList.astro";
import MobileToast from "../../components/vibe/MobileToast.astro";

export const prerender = false;

const vibe = Astro.params.vibe;
const allReviews = vibe ? await getReviewsByVibe(vibe) : [];

// Agrupar películas por film_id y contar las reviews
const reviewsMap = new Map();
allReviews.forEach(review => {
  if (!reviewsMap.has(review.film_id)) {
    reviewsMap.set(review.film_id, {
      ...review,
      count: 1,
      reviewIds: [review.id]
    });
  } else {
    const existing = reviewsMap.get(review.film_id);
    existing.count++;
    existing.reviewIds.push(review.id);
  }
});

const reviews = Array.from(reviewsMap.values());
---

<Layout title={`${vibe || "Vibe"} - Zinema Kamikaze`}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/VibePage.css" />
  </Fragment>

  <main class="reviews-layout">
    <VibeHeader vibe={vibe || ''} />

    <div class="main-container">
      <VibeSidebar />
      <VibeReviewsList reviews={reviews} />
    </div>

    <MobileToast />
  </main>
</Layout>

<script>
  import { initVibePage } from '../../scripts/vibe/index';
  initVibePage();
</script>
