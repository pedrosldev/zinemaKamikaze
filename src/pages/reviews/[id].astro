---
import { getReviewById, getReviewCountByFilmId, getCommentsByReviewId } from "../../lib/db";
import ReviewLayout from "../../layouts/ReviewLayout.astro";
import ReviewHeader from "../../components/reviews/ReviewHeader.astro";
import ReviewTabs from "../../components/reviews/ReviewTabs.astro";
import CommentsModal from "../../components/reviews/CommentsModal.astro";
import ReviewFooter from "../../components/reviews/ReviewFooter.astro";

export const prerender = false;

const review = await getReviewById(Number(Astro.params.id));
const reviewCount = review ? await getReviewCountByFilmId(review.film_id) : 0;
const comments = review ? await getCommentsByReviewId(review.id) : [];
---

<ReviewLayout title={review ? `${review.title} - ZinemaKamikaze` : "Review no encontrada"}>
  {
    review ? (
      <>
        <ReviewHeader
          title={review.title}
          year={review.year}
          filmId={review.film_id}
          vibe={review.vibe}
          expectationMood={review.expectation_mood ?? null}
          finalMood={review.final_mood ?? null}
          selectedBy={review.selected_by ?? null}
          reviewCount={reviewCount}
          commentsCount={comments.length}
        />

        <ReviewTabs
          hasVideo={!!review.youtube_id}
          hasText={!!review.review}
          youtubeId={review.youtube_id ?? null}
          reviewText={review.review ?? null}
        />

        <CommentsModal
          reviewId={review.id}
          comments={comments}
        />

        <ReviewFooter />
      </>
    ) : (
      <p>Review no encontrada</p>
    )
  }
</ReviewLayout>
