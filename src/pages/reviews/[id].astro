---
import { getReviewById, getReviewCountByFilmId, getCommentsByReviewId } from "../../lib/db";
import Layout from "../../layouts/Layout.astro";
import MoodBadge from "../../components/shared/MoodBadge.astro";
import { getMoodConfig } from "../../lib/moodMapper";
export const prerender = false; // Consultar
// const { params} = Astro;
const review = await getReviewById(Number(Astro.params.id));
const reviewCount = review ? await getReviewCountByFilmId(review.film_id) : 0;
const comments = review ? await getCommentsByReviewId(review.id) : [];
---

<Layout>
  {
    review ? (
      <>
        <head>
          <meta charset="utf-8" />
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
          <link
            href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
            rel="stylesheet"
          />
          <link rel="stylesheet" href="/styles/ReviewDetail.css" />
        </head>
        <header>
          <div class="header-content">
            <!-- Icono expectativa inicial (izquierda) -->
            {review.expectation_mood && (
              <div class="mood-container">
                <p class="mood-title" style="font-family: 'Special Elite', cursive;">Mi expectativa antes de verla</p>
                <MoodBadge 
                  mood={review.expectation_mood} 
                  type="expectation" 
                  variant="initial" 
                  showLabel={false}
                />
                <small class="mood-label">
                  {getMoodConfig(review.expectation_mood, 'expectation')?.label}
                </small>
              </div>
            )}
            
            <div class="header-center">
              <h1>
                {review.title}{" "}
                {review.year && review.year !== 0 ? `(${review.year})` : ""}
              </h1>
              <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                {reviewCount > 1 && (
                  <a href={`/movies/${review.film_id}`} class="multiple-reviews-link">
                    📽️ Ver los {reviewCount} visionados
                  </a>
                )}
                <a href={`/vibe/${review.vibe}`}>Volver a {review.vibe}</a>
                <a href="/" class="back-link">
                  Volver al listado
                </a>
                <button class="comments-btn">
                  💬 Comentarios ({comments.length})
                </button>
              </div>
              {review.selected_by && (
                <p class="selected-by-credit">
                  🎲 Seleccionada por: <strong>{review.selected_by}</strong>
                </p>
              )}
            </div>
            
            <!-- Icono mood final (derecha) -->
            {review.final_mood && (
              <div class="mood-container">
                <p class="mood-title">Mi expectativa después de verla</p>
                <MoodBadge 
                  mood={review.final_mood} 
                  type="final" 
                  variant="final" 
                  showLabel={false}
                />
                <small class="mood-label">
                  {getMoodConfig(review.final_mood, 'final')?.label}
                </small>
              </div>
            )}
          </div>
        </header>

        <!-- Pestañas (si hay al menos video o texto) -->
        {(review.youtube_id || review.review) && (
          <div class="tabs-container">
            <button class="tab-btn active" data-tab="text-content">
              📝 Reseña Escrita
            </button>
            <button class="tab-btn" data-tab="video-content">
              🎥 Video Reseña
            </button>
          </div>
        )}

        {(review.review || review.youtube_id) && (
          <div class="toggle-container" style="display: flex; gap: 0.3rem; justify-content: center; flex-direction: column; align-items: center;">
            <img
              id="toggle-animation"
              src="/images/pause-square-svgrepo-com.svg"
              alt="Play/Pause"
            />
            <span class="toggle-text">Pausar crítica</span>
          </div>
        )}

        <div class="credits-container">
          <!-- Video crítica (si existe youtube_id) -->
          <section class="video-review tab-content" id="video-content" style={(review.review || !review.youtube_id) ? "display: none;" : ""}>
            {review.youtube_id ? (
              <lite-youtube 
                videoid={review.youtube_id}
                style={`background-image: url('https://i.ytimg.com/vi/${review.youtube_id}/hqdefault.jpg');`}
              ></lite-youtube>
            ) : (
              <div class="no-content-message">
                <p>🎥</p>
                <p>Esta reseña no tiene video review</p>
              </div>
            )}
          </section>

          <!-- Texto de la review (si existe) -->
          <div id="text-content" class="credits-text tab-content" style="display: flex;">
            {review.review ? (
              review.review.split('\n').map((line: string) => <p>{line}</p>)
            ) : (
              <div class="no-content-message static">
                <p>📝</p>
                <p>Esta reseña no tiene texto escrito</p>
              </div>
            )}
          </div>
        </div>

        <!-- Modal de Comentarios -->
        <div id="comments-modal" class="comments-modal">
          <div class="modal-overlay"></div>
          <div class="modal-content">
            <div class="modal-header">
              <h2 class="comments-title">💬 Comentarios ({comments.length})</h2>
              <button class="close-modal-btn" aria-label="Cerrar">
                ✕
              </button>
            </div>
          
          <!-- Lista de comentarios -->
          <div class="comments-list">
            {comments.length > 0 ? (
              comments.map((comment) => (
                <div class="comment-item">
                  <div class="comment-header">
                    <strong class="comment-author">{comment.author_name}</strong>
                    <span class="comment-date">
                      {new Date(comment.created_at).toLocaleDateString('es-ES', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      })}
                    </span>
                  </div>
                  <p class="comment-content">{comment.content}</p>
                </div>
              ))
            ) : (
              <p class="no-comments">Sé el primero en comentar esta reseña</p>
            )}
          </div>

          <!-- Formulario para añadir comentario -->
          <div class="comment-form-container">
            <h3 class="form-title">Deja tu comentario</h3>
            <form id="comment-form" class="comment-form">
              <input type="hidden" name="review_id" value={review.id} />
              <div class="form-group">
                <label for="author-name">Tu nombre:</label>
                <input 
                  type="text" 
                  id="author-name" 
                  name="author_name" 
                  maxlength="100" 
                  required 
                  placeholder="Escribe tu nombre..."
                />
              </div>
              <div class="form-group">
                <label for="comment-content">Comentario:</label>
                <textarea 
                  id="comment-content" 
                  name="content" 
                  maxlength="2000" 
                  rows="4" 
                  required 
                  placeholder="Comparte tu opinión sobre esta reseña..."
                ></textarea>
                <small class="char-counter">
                  <span id="char-count">0</span>/2000 caracteres
                </small>
              </div>
              <button type="submit" class="submit-btn">Enviar comentario</button>
            </form>
            <div id="form-message" class="form-message"></div>
          </div>
        </div>
      </div>

        <footer class="review-footer">
          <div class="footer-content">
            <p>ZINEMA KAMIKAZE © {new Date().getFullYear()}</p>
          </div>
        </footer>

<script>
  // Importar lite-youtube dinámicamente solo en el cliente
  if (typeof window !== 'undefined') {
    import('@justinribeiro/lite-youtube');
  }

  // Importar módulos de funcionalidad
  import { initToggleAnimation, initTabSwitch } from '../../scripts/review/toggleControls';
  import { initCommentsModal, initCommentForm } from '../../scripts/review/commentsModal';

  // Inicializar funcionalidades cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    initToggleAnimation();
    initTabSwitch();
    initCommentsModal();
    initCommentForm();
  });
</script>
      </>
    ) : (
      <p>Review no encontrada</p>
    )
  }
</Layout>
