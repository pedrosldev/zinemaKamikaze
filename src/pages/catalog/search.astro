---
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import SearchControls from "../../components/catalog/SearchControls.astro";
import { getUniqueYears, getAllMovies } from "../../lib/catalogUtils";
import MovieCard from '../../components/catalog/MovieCard.astro';

export const prerender = false;

// Obtener años únicos para el select
const years = getUniqueYears();

// Obtener todas las películas
const allMovies = getAllMovies();

// SSR: obtener query params para búsqueda inicial si vienen de URL
const url = new URL(Astro.request.url);
const initialQuery = url.searchParams.get('q') || '';
const initialYear = url.searchParams.get('year') || '';

// Solo para meta tags
const pageTitle = "Buscar películas - Zinema Kamikaze";
---

<CatalogLayout title={pageTitle}>
  <main class="catalog-layout">
    <SearchControls 
      years={years} 
      initialQuery={initialQuery} 
      initialYear={initialYear} 
    />

    <!-- Contenedor principal -->
    <div class="main-container">
      <!-- Sidebar -->
      <div class="wide-sidebar">
        <div class="film-grain"></div>
        <div class="old-film-scratches"></div>
      </div>

      <!-- Área de contenido -->
      <div class="content-scrollable">
        <!-- Results info -->
        <p id="resultsCount" class="results-info"></p>

        <!-- Grid de películas -->
        <ul class="movies-grid" id="moviesGrid">
          {allMovies.map((movie) => (
            <MovieCard movie={movie} />
          ))}
        </ul>

        <!-- No results message -->
        <div class="no-results" id="noResults" style="display: none;">
          <p>No se encontraron películas con esos criterios</p>
          <button id="resetBtn" class="reset-btn">Mostrar todas</button>
        </div>
      </div>
    </div>
  </main>
</CatalogLayout>

<script>
  import { initCatalogSearch } from '../../scripts/catalog/catalogSearch';
  import { initCatalogSelection } from '../../scripts/catalog/catalogSelection';
  
  // Inicializar búsqueda y selección cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    initCatalogSearch();
    initCatalogSelection();
  });
</script>

