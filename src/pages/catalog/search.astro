---
import Layout from "../../layouts/Layout.astro";
import { getUniqueYears, getAllMovies } from "../../lib/catalogUtils";
import MovieCard from '../../components/catalog/MovieCard.astro';
import allTitlesData from '../../data/all_titles_with_id.json';

export const prerender = false;

// Obtener años únicos para el select
const years = getUniqueYears();

// Obtener todas las películas
const allMovies = getAllMovies();

// SSR: obtener query params para búsqueda inicial si vienen de URL
const url = new URL(Astro.request.url);
const initialQuery = url.searchParams.get('q') || '';
const initialYear = url.searchParams.get('year') || '';

// Solo para meta tags
const pageTitle = "Buscar películas - Zinema Kamikaze";
---

<Layout>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Sigmar&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>

  <div class="search-layout">
    <main class="catalog-layout">
      <!-- Header pantalla completa -->
      <div class="full-width-header">
        <h1>BUSCAR EN EL CATÁLOGO</h1>
        
        <!-- Search Controls -->
        <div class="search-controls">
          <div class="search-input-wrapper">
            <input
              type="text"
              id="searchInput"
              placeholder="Buscar por título..."
              value={initialQuery}
              autocomplete="off"
            />
          </div>

          <div class="filter-wrapper">
            <select id="yearFilter">
              <option value="">Todos los años</option>
              {years.map(year => (
                <option value={year} selected={year === initialYear}>
                  {year || 'Sin año'}
                </option>
              ))}
            </select>
          </div>

          <button id="clearBtn" class="clear-btn">Limpiar filtros</button>
        </div>

        <a href="/catalog" class="back-link">← Volver al catálogo</a>
        <div class="film-grain"></div>
        <div class="old-film-scratches"></div>
      </div>

      <!-- Contenedor principal -->
      <div class="main-container">
        <!-- Sidebar -->
        <div class="wide-sidebar">
          <div class="film-grain"></div>
          <div class="old-film-scratches"></div>
        </div>

        <!-- Área de contenido -->
        <div class="content-scrollable">
          <!-- Results info -->
          <p id="resultsCount" class="results-info"></p>

          <!-- Grid de películas -->
          <ul class="movies-grid" id="moviesGrid">
            {allMovies.map((movie) => (
              <MovieCard movie={movie} />
            ))}
          </ul>

          <!-- No results message -->
          <div class="no-results" id="noResults" style="display: none;">
            <p>No se encontraron películas con esos criterios</p>
            <button id="resetBtn" class="reset-btn">Mostrar todas</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  // Cargar todas las películas y datos raíz en el cliente
  import allTitlesData from '../../data/all_titles_with_id.json';
  import { getPosterUrl } from '../../lib/catalogUtils';
  import type { Movie } from '../../lib/catalogUtils';

  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const yearFilter = document.getElementById('yearFilter') as HTMLSelectElement;
  const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement;
  const moviesGrid = document.getElementById('moviesGrid') as HTMLDivElement;
  const resultsCount = document.getElementById('resultsCount') as HTMLParagraphElement;
  const noResults = document.getElementById('noResults') as HTMLDivElement;

  // Función para filtrar películas por título raíz o individual
  function filterMovies() {
    const query = searchInput.value.trim();
    const year = yearFilter.value;

    if (query === '' && year === '') {
      // Mostrar todas las películas
      const allMovies: Movie[] = [];
      for (const entry of allTitlesData) {
        if (entry.films && Array.isArray(entry.films)) {
          allMovies.push(...entry.films);
        }
      }
      displayMovies(allMovies.sort((a, b) => a.title.localeCompare(b.title, 'es')));
      updateResultsCount(allMovies.length, query, year);
      return;
    }

    const queryLower = query.toLowerCase();
    const matchedMovies: Movie[] = [];
    const seenIds = new Set<number>();

    // Buscar en títulos raíz de grupos
    for (const entry of allTitlesData) {
      if (entry.title && entry.title.toLowerCase().includes(queryLower)) {
        // Si el título raíz coincide, agregar TODAS las películas del grupo
        if (entry.films && Array.isArray(entry.films)) {
          entry.films.forEach(movie => {
            if (!seenIds.has(movie.id)) {
              const matchYear = year === '' || movie.year === year;
              if (matchYear) {
                matchedMovies.push(movie);
                seenIds.add(movie.id);
              }
            }
          });
        }
      } else {
        // Si no coincide el título raíz, buscar en títulos individuales
        if (entry.films && Array.isArray(entry.films)) {
          entry.films.forEach(movie => {
            if (!seenIds.has(movie.id) && movie.title.toLowerCase().includes(queryLower)) {
              const matchYear = year === '' || movie.year === year;
              if (matchYear) {
                matchedMovies.push(movie);
                seenIds.add(movie.id);
              }
            }
          });
        }
      }
    }

    const sorted = matchedMovies.sort((a, b) => a.title.localeCompare(b.title, 'es'));
    displayMovies(sorted);
    updateResultsCount(sorted.length, query, year);
  }

  // Función para mostrar películas
  function displayMovies(movies: Movie[]) {
    const movieCards = Array.from(document.querySelectorAll('.movie-card')) as HTMLElement[];
    const movieIds = new Set(movies.map(m => m.id));
    
    if (movies.length === 0) {
      movieCards.forEach(card => card.style.display = 'none');
      noResults.style.display = 'block';
      return;
    }

    noResults.style.display = 'none';
    
    // Mostrar/ocultar tarjetas según el filtro
    movieCards.forEach(card => {
      const movieId = parseInt(card.getAttribute('data-poster-url')?.split('/').pop()?.split('.')[0] || '0');
      const link = card.querySelector('a');
      const href = link?.getAttribute('href') || '';
      const id = parseInt(href.replace('/movies/', ''));
      
      if (movieIds.has(id)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // Actualizar contador de resultados
  function updateResultsCount(count: number, query: string, year: string) {
    let text = `${count.toLocaleString()} película${count !== 1 ? 's' : ''} encontrada${count !== 1 ? 's' : ''}`;
    
    if (query || year) {
      const filters = [];
      if (query) filters.push(`"${query}"`);
      if (year) filters.push(`año ${year}`);
      text += ` con ${filters.join(' y ')}`;
    }
    
    resultsCount.textContent = text;
  }

  // Función para limpiar filtros
  function clearFilters() {
    searchInput.value = '';
    yearFilter.value = '';
    filterMovies();
    searchInput.focus();
  }

  // Event listeners
  searchInput.addEventListener('input', filterMovies);
  yearFilter.addEventListener('change', filterMovies);
  clearBtn.addEventListener('click', clearFilters);
  resetBtn.addEventListener('click', clearFilters);

  // Filtrar en carga inicial
  filterMovies();
</script>

<style>
  /* Layout principal */
  .search-layout {
    min-height: 100vh;
    background-color: #000;
  }

  /* Estilos del catálogo */
  .catalog-layout {
    min-height: 100vh;
    background-color: #000;
    color: #fff;
  }

  /* Header pantalla completa */
  .full-width-header {
    position: relative;
    width: 100%;
    height: 25vh;
    min-height: 200px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #1a1a1a 0%, #000 100%);
    overflow: hidden;
  }

  .full-width-header h1 {
    font-family: "Sigmar", cursive;
    font-size: clamp(2rem, 8vw, 5rem);
    text-align: center;
    color: #f5d742;
    text-shadow: 0 0 20px rgba(245, 215, 66, 0.5),
                 2px 2px 0 #000,
                 -2px -2px 0 #000;
    z-index: 2;
    margin: 0;
    padding: 0 20px;
  }

  .back-link {
    color: #f5d742;
    text-decoration: none;
    font-size: 1rem;
    padding: 0.5rem 1rem;
    border: 2px solid #f5d742;
    border-radius: 4px;
    transition: all 0.3s ease;
    z-index: 2;
    margin-top: 1rem;
  }

  .back-link:hover {
    background: #f5d742;
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 215, 66, 0.4);
  }

  /* Efectos de película */
  .film-grain {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.03;
    z-index: 1;
    pointer-events: none;
  }

  .old-film-scratches {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(255, 255, 255, 0.02) 50%
    );
    background-size: 100% 4px;
    opacity: 0.1;
    z-index: 1;
    pointer-events: none;
  }

  /* Container principal */
  .main-container {
    display: flex;
    min-height: 100vh;
    background-color: #000;
  }

  .wide-sidebar {
    position: sticky;
    top: 0;
    width: 15vw;
    min-width: 150px;
    height: 100vh;
    background: linear-gradient(135deg, #1a1a1a 0%, #000 100%);
    flex-shrink: 0;
    overflow: hidden;
  }

  .content-scrollable {
    flex: 1;
    padding: 2rem;
    position: relative;
    overflow-y: auto;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Grid de películas */
  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 200px));
    gap: 1.5rem;
    padding: 0;
    margin: 0 auto 3rem auto;
    list-style: none;
    width: 100%;
    max-width: 1000px;
    justify-content: center;
  }

  /* Search controls dentro del header */
  .search-controls {
    max-width: 800px;
    margin: 1rem auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    z-index: 2;
  }

  .search-input-wrapper {
    flex: 1;
  }

  #searchInput {
    width: 100%;
    padding: 0.75rem;
    font-size: 1rem;
    font-family: 'Sigmar', cursive;
    background: rgba(245, 215, 66, 0.1);
    border: 2px solid #f5d742;
    color: #f5d742;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  #searchInput:focus {
    outline: none;
    background: rgba(245, 215, 66, 0.2);
    box-shadow: 0 0 20px rgba(245, 215, 66, 0.3);
  }

  #searchInput::placeholder {
    color: rgba(245, 215, 66, 0.5);
  }

  .filter-wrapper {
    flex: 1;
  }

  #yearFilter {
    width: 100%;
    padding: 0.75rem;
    font-size: 1rem;
    font-family: 'Sigmar', cursive;
    background: rgba(245, 215, 66, 0.1);
    border: 2px solid #f5d742;
    color: #f5d742;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #yearFilter:focus {
    outline: none;
    background: rgba(245, 215, 66, 0.2);
    box-shadow: 0 0 20px rgba(245, 215, 66, 0.3);
  }

  #yearFilter option {
    background: #000;
    color: #f5d742;
  }

  .clear-btn, .reset-btn {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-family: 'Sigmar', cursive;
    background: transparent;
    border: 2px solid #f5d742;
    color: #f5d742;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .clear-btn:hover, .reset-btn:hover {
    background: #f5d742;
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(245, 215, 66, 0.4);
  }

  .results-info {
    text-align: center;
    font-size: 1rem;
    color: rgba(245, 215, 66, 0.8);
    margin-bottom: 2rem;
  }

  .no-results {
    max-width: 600px;
    margin: 4rem auto;
    padding: 2rem;
    text-align: center;
  }

  .no-results p {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }

  /* Responsive */
  @media (min-width: 768px) {
    .search-controls {
      flex-direction: row;
      align-items: center;
    }

    .search-input-wrapper {
      flex: 2;
    }

    .filter-wrapper {
      flex: 1;
    }

    .clear-btn {
      flex-shrink: 0;
    }
  }
</style>
</Layout>
