---
import { generateCatalogPaths, getMoviesForPage } from '../../lib/catalogUtils';
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import CatalogPageHeader from '../../components/catalog/CatalogPageHeader.astro';
import Pagination from '../../components/catalog/Pagination.astro';
import MovieCard from '../../components/catalog/MovieCard.astro';

export const prerender = true;

export async function getStaticPaths() {
  return generateCatalogPaths(100);
}

const { page } = Astro.params;
const currentPage = parseInt(page);
const { movies, totalPages, totalMovies } = getMoviesForPage(currentPage, 100);

// Calcular páginas cercanas para paginación
const nearbyPages = Array.from({ length: 5 }, (_, i) => {
  const pageNum = currentPage - 2 + i;
  if (pageNum > 0 && pageNum <= totalPages) {
    return pageNum;
  }
  return null;
}).filter(Boolean);
---

<CatalogLayout title={`Catálogo - Página ${currentPage} - Zinema Kamikaze`}>
  <main class="catalog-layout">
    <CatalogPageHeader 
      currentPage={currentPage} 
      totalPages={totalPages} 
      totalMovies={totalMovies} 
    />

    <!-- Contenedor principal -->
    <div class="main-container">
      <!-- Sidebar izquierdo -->
      <div class="wide-sidebar wide-sidebar-left">
        <div class="film-grain"></div>
        <div class="old-film-scratches"></div>
      </div>

      <!-- Sidebar derecho -->
      <div class="wide-sidebar wide-sidebar-right">
        <div class="film-grain"></div>
        <div class="old-film-scratches"></div>
      </div>

      <!-- Área de contenido -->
      <div class="content-scrollable">
        <div class="scroll-arrow scroll-up">
          <img src="/images/caret-circle-up-svgrepo-com.svg" alt="Scroll Up" />
        </div>

        <!-- Grid de películas -->
        <ul class="movies-grid">
          {movies.map((movie) => (
            <MovieCard movie={movie} />
          ))}
        </ul>

        <Pagination 
          currentPage={currentPage} 
          totalPages={totalPages} 
          nearbyPages={nearbyPages} 
        />

        <div class="scroll-arrow scroll-down">
          <img src="/images/caret-circle-down-svgrepo-com.svg" alt="Scroll Down" />
        </div>
      </div>
    </div>
  </main>
</CatalogLayout>

<script>
  import { initCatalogScroll } from '../../scripts/catalog/catalogScroll';
  
  document.addEventListener('DOMContentLoaded', () => {
    initCatalogScroll();
  });
</script>
