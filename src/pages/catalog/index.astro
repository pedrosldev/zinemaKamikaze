---
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import { getTotalPages } from "../../lib/catalogUtils";

const totalPages = getTotalPages(100);
const totalMovies = 18266; // Aproximado
---

<CatalogLayout title="Catálogo Completo - Zinema Kamikaze">
  <main class="catalog-index">
    <div class="catalog-hero">
      <h1>CATÁLOGO COMPLETO</h1>
      
      <div class="catalog-stats">
        <p class="stat-item">
          <span class="stat-number">{totalMovies}</span>
          <span class="stat-label">Películas</span>
        </p>
        <p class="stat-item">
          <span class="stat-number">{totalPages}</span>
          <span class="stat-label">Páginas</span>
        </p>
      </div>

      <a href="/catalog/1" class="start-button">Explorar Catálogo →</a>

      <a href="/" class="back-link">← Volver al inicio</a>

      <div class="film-grain"></div>
      <div class="old-film-scratches"></div>
    </div>
  </main>
</CatalogLayout>

<script>
  import { hasCatalogToken } from '../../scripts/catalog/catalogSelection';
  
  // Si hay un token activo, redirigir directamente a la página 1
  if (hasCatalogToken()) {
    window.location.href = '/catalog/1';
  }
</script>
