---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
}

const { title = "Admin - Zinema Kamikaze" } = Astro.props;
---

<Layout title={title}>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/Admin.css" />
  </Fragment>

  <slot />
</Layout>
