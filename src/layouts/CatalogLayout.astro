---
import Layout from "./Layout.astro";

interface Props {
  title?: string;
}

const { title = "Catálogo - Zinema Kamikaze" } = Astro.props;
---

<Layout title={title}>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/Catalog.css" />
  </Fragment>

  <div class="catalog-layout">
    <slot />
  </div>

  <!-- Efectos de película reutilizables -->
  <div class="film-grain"></div>
  <div class="old-film-scratches"></div>
</Layout>
