---
// src/components/MovieSelector.astro
// Componente para mostrar 3 opciones de películas y permitir elegir una

interface Movie {
  film_id: number;
  title: string;
  year: string | number;
  poster: string;
}

interface Props {
  movies: Movie[];
  token: string;
  selectedBy?: string;
}

const { movies = [], token = '', selectedBy = '' } = Astro.props;
---

<div id="movieSelector" class="movie-selector-container" style="display: none;">
  <div class="selector-overlay"></div>
  
  <div class="selector-content">
    <div class="selector-header">
      <h2>🎬 ELIGE TU PELÍCULA</h2>
      <p>Selecciona una de estas 3 opciones:</p>
    </div>

    <div class="movies-grid" id="moviesGrid">
      <!-- Las películas se insertarán dinámicamente desde JS -->
    </div>

    <div id="selectorMessage" class="selector-message"></div>
  </div>
</div>

<style>
  .movie-selector-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    font-family: 'Special Elite', cursive;
  }

  .movie-selector-container.active {
    display: flex;
  }

  .selector-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(8px);
  }

  .selector-content {
    position: relative;
    background: linear-gradient(135deg, rgba(26, 84, 250, 0.2) 0%, rgba(10, 10, 10, 0.95) 100%);
    border: 3px solid rgba(245, 215, 66, 0.6);
    border-radius: 12px;
    padding: 2rem;
    max-width: 95%;
    width: 1200px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(245, 215, 66, 0.4);
    animation: appear 0.5s ease-out;
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: scale(0.9) translateY(20px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .selector-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .selector-header h2 {
    color: #f5d742;
    font-size: 2rem;
    margin: 0 0 0.5rem 0;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
  }

  .selector-header p {
    color: #c9be9c;
    font-size: 1.1rem;
    margin: 0;
  }

  .movies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .movie-card {
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(245, 215, 66, 0.3);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .movie-card:hover {
    border-color: #f5d742;
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(245, 215, 66, 0.5);
  }

  .movie-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.8) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }

  .movie-card:hover::before {
    opacity: 1;
  }

  .movie-poster {
    width: 100%;
    aspect-ratio: 2/3;
    object-fit: cover;
    display: block;
    background: linear-gradient(135deg, #1a54fa 0%, #0a0a0a 100%);
  }

  .movie-info {
    padding: 1.5rem;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .movie-title {
    color: #f5d742;
    font-size: 1.2rem;
    margin: 0 0 0.5rem 0;
    font-weight: bold;
    line-height: 1.3;
  }

  .movie-year {
    color: #c9be9c;
    font-size: 0.95rem;
    margin: 0;
  }

  .choose-btn {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #f5d742 0%, #d4b82a 100%);
    color: #000;
    border: none;
    padding: 0.75rem 1.5rem;
    font-family: 'Special Elite', cursive;
    font-size: 0.95rem;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    z-index: 3;
  }

  .movie-card:hover .choose-btn {
    opacity: 1;
    transform: translateX(-50%) translateY(-4px);
  }

  .choose-btn:hover {
    background: linear-gradient(135deg, #ffd700 0%, #f5d742 100%);
    box-shadow: 0 6px 20px rgba(245, 215, 66, 0.6);
  }

  .selector-message {
    text-align: center;
    padding: 1rem;
    border-radius: 6px;
    font-weight: bold;
    min-height: 20px;
  }

  .selector-message.success {
    background: rgba(34, 197, 94, 0.2);
    border: 2px solid #22c55e;
    color: #4ade80;
  }

  .selector-message.error {
    background: rgba(239, 68, 68, 0.2);
    border: 2px solid #ef4444;
    color: #f87171;
  }

  .selector-message.loading {
    background: rgba(245, 215, 66, 0.2);
    border: 2px solid #f5d742;
    color: #ffd700;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .selector-content {
      padding: 1.5rem;
    }

    .selector-header h2 {
      font-size: 1.5rem;
    }

    .selector-header p {
      font-size: 0.95rem;
    }

    .movies-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .movie-card {
      max-width: 400px;
      margin: 0 auto;
    }

    .choose-btn {
      opacity: 1;
      position: static;
      transform: none;
      width: 100%;
      margin-top: 1rem;
    }
  }
</style>
