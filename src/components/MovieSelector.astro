---
// src/components/MovieSelector.astro
// Componente para mostrar 3 opciones de películas y permitir elegir una
// Los estilos están en /public/styles/MovieSelector.css

interface Movie {
  film_id: number;
  title: string;
  year: string | number;
  poster: string;
}

interface Props {
  movies: Movie[];
  token: string;
  selectedBy?: string;
}

const { movies = [], token = '', selectedBy = '' } = Astro.props;
---

<div id="movieSelector" class="movie-selector-container" style="display: none;">
  <div class="selector-overlay"></div>
  
  <div class="selector-content">
    <div class="selector-header">
      <h2>🎬 ELIGE TU PELÍCULA</h2>
      <p>Selecciona una de estas 3 opciones:</p>
    </div>

    <div class="movies-grid" id="moviesGrid">
      <!-- Las películas se insertarán dinámicamente desde JS -->
    </div>

    <div id="selectorMessage" class="selector-message"></div>
  </div>
</div>
