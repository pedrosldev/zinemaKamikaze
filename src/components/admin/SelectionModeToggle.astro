---
// src/components/admin/SelectionModeToggle.astro
import { getSelectionMode } from '../../lib/db';

const currentMode = await getSelectionMode();
---

<div class="selection-mode-container">
  <h2>⚙️ MODO DE SELECCIÓN DE PELÍCULAS</h2>
  
  <div class="mode-description">
    <p>Controla cómo se eligen las películas cuando se usa un token:</p>
  </div>

  <div class="mode-options">
    <label class="mode-option">
      <input 
        type="radio" 
        name="selection_mode" 
        value="normal" 
        checked={currentMode === 'normal'}
      />
      <div class="option-content">
        <strong>🎲 Normal</strong>
        <small>Se elige 1 película aleatoria directamente</small>
      </div>
    </label>

    <label class="mode-option">
      <input 
        type="radio" 
        name="selection_mode" 
        value="triple_choice" 
        checked={currentMode === 'triple_choice'}
      />
      <div class="option-content">
        <strong>🎯 Triple Elección</strong>
        <small>El usuario elige entre 3 películas aleatorias</small>
      </div>
    </label>

    <label class="mode-option">
      <input 
        type="radio" 
        name="selection_mode" 
        value="catalog" 
        checked={currentMode === 'catalog'}
        disabled
      />
      <div class="option-content">
        <strong>📚 Catálogo Completo</strong>
        <small>Acceso al catálogo completo (próximamente)</small>
      </div>
    </label>
  </div>

  <button id="saveSelectionMode" class="save-mode-btn">
    💾 GUARDAR CAMBIOS
  </button>

  <div id="modeMessage" class="mode-message"></div>
</div>

<style>
  .selection-mode-container {
    background: linear-gradient(135deg, rgba(26, 84, 250, 0.1) 0%, rgba(10, 10, 10, 0.2) 100%);
    border: 2px solid rgba(245, 215, 66, 0.3);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .selection-mode-container h2 {
    color: #f5d742;
    font-family: 'Special Elite', cursive;
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    text-align: center;
  }

  .mode-description {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .mode-description p {
    color: #c9be9c;
    font-size: 0.95rem;
    margin: 0;
  }

  .mode-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .mode-option {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border: 2px solid rgba(245, 215, 66, 0.2);
    border-radius: 6px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .mode-option:hover:not(:has(input:disabled)) {
    background: rgba(245, 215, 66, 0.1);
    border-color: rgba(245, 215, 66, 0.5);
    transform: translateX(4px);
  }

  .mode-option:has(input:checked) {
    background: rgba(245, 215, 66, 0.15);
    border-color: #f5d742;
  }

  .mode-option:has(input:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .mode-option input[type="radio"] {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: #f5d742;
  }

  .mode-option input[type="radio"]:disabled {
    cursor: not-allowed;
  }

  .option-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .option-content strong {
    color: #f5d742;
    font-size: 1.1rem;
    font-family: 'Special Elite', cursive;
  }

  .option-content small {
    color: #c9be9c;
    font-size: 0.85rem;
  }

  .save-mode-btn {
    width: 100%;
    background: linear-gradient(135deg, #f5d742 0%, #d4b82a 100%);
    color: #000;
    border: none;
    padding: 1rem 2rem;
    font-family: 'Special Elite', cursive;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .save-mode-btn:hover {
    background: linear-gradient(135deg, #ffd700 0%, #f5d742 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 215, 66, 0.4);
  }

  .save-mode-btn:active {
    transform: translateY(0);
  }

  .mode-message {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: 4px;
    text-align: center;
    font-weight: bold;
    min-height: 20px;
    transition: all 0.3s ease;
  }

  .mode-message.success {
    background: rgba(34, 197, 94, 0.2);
    border: 2px solid #22c55e;
    color: #4ade80;
  }

  .mode-message.error {
    background: rgba(239, 68, 68, 0.2);
    border: 2px solid #ef4444;
    color: #f87171;
  }

  @media (max-width: 768px) {
    .selection-mode-container {
      padding: 1.5rem;
    }

    .selection-mode-container h2 {
      font-size: 1.2rem;
    }

    .mode-option {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
