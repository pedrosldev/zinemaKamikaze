---
/**
 * Panel de la taquilla pública.
 *
 * El token sigue existiendo por dentro, pero aquí ya no se muestra ni se
 * reparte: el admin solo abre o cierra la ronda.
 */
interface Props {
  open: boolean;
  openedAt: string | null;
  token: string | null;
}

const { open, openedAt, token } = Astro.props;

const openedLabel = openedAt
  ? new Date(openedAt).toLocaleString("es-ES", {
      dateStyle: "short",
      timeStyle: "short",
    })
  : null;
---

<section
  class="tokens-section taquilla-admin"
  id="taquillaAdmin"
  data-open={open ? "true" : "false"}
>
  <h2>TAQUILLA PÚBLICA</h2>

  <p class="taquilla-admin__state">
    <span class="taquilla-admin__dot" aria-hidden="true"></span>
    {open ? "ABIERTA" : "CERRADA"}
  </p>

  <p class="taquilla-admin__hint">
    {
      open
        ? `El primero que pulse el botón en la portada elige la película.${
            openedLabel ? ` Abierta desde ${openedLabel}.` : ""
          }`
        : "Sin sorteo en curso. Al abrir, el botón aparece en la portada."
    }
  </p>

  <button
    id="taquillaToggle"
    class="generate-btn"
    type="button"
    data-action={open ? "close" : "open"}
  >
    {open ? "CERRAR TAQUILLA" : "ABRIR TAQUILLA"}
  </button>

  {
    open && token && (
      <details class="taquilla-admin__code">
        <summary>Código de la ronda (uso manual)</summary>
        <code>{token}</code>
        <p>
          Solo hace falta en los modos triple elección y catálogo, donde la portada sigue
          pidiendo el código. En el modo normal no lo necesitas.
        </p>
      </details>
    )
  }

  <p id="taquillaAdminMessage" class="mode-message"></p>
</section>

<style>
  .taquilla-admin__state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #c9be9c;
  }

  .taquilla-admin__dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #8a8067;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.4);
  }

  .taquilla-admin[data-open="true"] .taquilla-admin__dot {
    background: #4caf50;
    box-shadow: 0 0 8px rgba(76, 175, 80, 0.7);
  }

  .taquilla-admin__hint {
    margin: 0 0 1.25rem;
    color: #a89d84;
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: center;
  }

  .taquilla-admin__code {
    margin: 0 auto 1rem;
    max-width: 34rem;
    color: #a89d84;
    font-size: 0.9rem;
  }

  .taquilla-admin__code summary {
    cursor: pointer;
    color: #c9be9c;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .taquilla-admin__code code {
    display: block;
    margin: 0.6rem 0;
    padding: 0.6rem;
    background: rgba(26, 26, 24, 0.9);
    border: 1px solid rgba(107, 63, 47, 0.8);
    border-radius: 4px;
    word-break: break-all;
    color: #f5d742;
  }

  .taquilla-admin__code p {
    margin: 0;
    line-height: 1.45;
  }
</style>
