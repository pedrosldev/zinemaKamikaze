---
// Import any necessary modules for database access
// Replace this with your actual database access function
import { getAllVibes } from "../lib/db";

const vibes = await getAllVibes();

// Props interface
interface Props {
  titulo?: string;
  vibes: string[];
}

const { titulo = "Vibreviews" } = Astro.props;
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <link
    href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
    rel="stylesheet"
  />
</head>
<div class="acordeon">
  <button class="acordeon-titulo-principal" aria-expanded="false">
    <span class="titulo-texto">{titulo}</span>
    <span class="icono"
      ><img src="/images/down-arrow-svgrepo-com.svg" alt="" /></span
    >
  </button>

  <div class="acordeon-contenido">
    <div class="acordeon-contenido-interior">
      {
        vibes.map((vibe) => (
          <div class="acordeon-item">
            <a href={`/vibe/${vibe}`} class="vibe-enlace">
              {vibe}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .acordeon {
    width: 70%;
    margin-right: 15px;
    position: relative;
    z-index: 150;
    /* margin: 0 auto; */
  }

  .acordeon-titulo-principal {
    font-family: "Special Elite", cursive;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 0.75rem;
    background: none;
    border: none;
    text-align: center;
    font-weight: bold;
    font-size: 1.25rem;
    cursor: pointer;
    transition: background-color 0.3s;
    margin-bottom: 0;
    position: relative; /* Para posicionamiento del icono */
  }

  .titulo-texto {
    display: inline-block;
    font-family: "Special Elite", cursive;
  }

  .icono {
    position: absolute;
    right: 5px;
    transition: transform 0.3s ease-in-out;
    font-size: 0.8em;
  }
  img {
    width: 20px;
    height: 20px;
  }
  .acordeon-titulo-principal[aria-expanded="true"] .icono {
    transform: rotate(180deg);
  }

  .acordeon-contenido {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.5s ease-in-out,
      opacity 0.4s ease-in-out,
      transform 0.4s ease-in-out;
    transform: translateY(-10px);
    pointer-events: none;
    position: relative;
    z-index: 200;
  }

  .acordeon-contenido-interior {
    padding: 0.5rem 0.5rem;
  }

  .acordeon-titulo-principal[aria-expanded="true"] + .acordeon-contenido {
    max-height: 500px;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .acordeon-item {
    padding: 0.25rem 0;
    /*border-bottom: 1px solid #eee;*/
    transform: translateY(10px);
    opacity: 0;
    transition:
      transform 0.3s ease-out,
      opacity 0.3s ease-out;
  }

  .acordeon-titulo-principal[aria-expanded="true"]
    + .acordeon-contenido
    .acordeon-item {
    transform: translateY(0);
    opacity: 1;
  }

  .acordeon-titulo-principal[aria-expanded="true"]
    + .acordeon-contenido
    .acordeon-item:nth-child(1) {
    transition-delay: 0.05s;
  }
  .acordeon-titulo-principal[aria-expanded="true"]
    + .acordeon-contenido
    .acordeon-item:nth-child(2) {
    transition-delay: 0.1s;
  }
  .acordeon-titulo-principal[aria-expanded="true"]
    + .acordeon-contenido
    .acordeon-item:nth-child(3) {
    transition-delay: 0.15s;
  }
  .acordeon-titulo-principal[aria-expanded="true"]
    + .acordeon-contenido
    .acordeon-item:nth-child(4) {
    transition-delay: 0.2s;
  }
  .acordeon-titulo-principal[aria-expanded="true"]
    + .acordeon-contenido
    .acordeon-item:nth-child(5) {
    transition-delay: 0.25s;
  }
  /* Puedes añadir más si tienes más elementos */

  .vibe-enlace {
    font-family: "Special Elite", cursive;
    text-decoration: none;
    color: #333;
    transition: color 0.2s;
    display: block;
    font-size: 0.9rem;
    text-shadow:
      0 0 10px #00ff00,
      0 0 10px #00ff00,
      0 0 10px #00ff00;
  }

  .vibe-enlace:hover {
    color: #0066cc;
  }

  /* Landscape mobile adjustments */
  @media screen and (max-width: 896px) and (orientation: landscape) {
    .acordeon {
      width: 95%;
      margin-right: 5px;
    }

    .acordeon-titulo-principal {
      font-size: 0.6rem;
      padding: 0.4rem;
    }

    .acordeon-contenido-interior {
      padding: 0.3rem;
      max-height: calc(100vh - 200px);
      overflow-y: auto;
    }

    .acordeon-titulo-principal[aria-expanded="true"] + .acordeon-contenido {
      max-height: calc(100vh - 150px);
    }

    .vibe-enlace {
      font-size: 0.5rem;
      padding: 0.2rem 0;
    }

    img {
      width: 12px;
      height: 12px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const botonPrincipal = document.querySelector(".acordeon-titulo-principal");

    botonPrincipal?.addEventListener("click", () => {
      const estaExpandido =
        botonPrincipal.getAttribute("aria-expanded") === "true";

      if (estaExpandido) {
        botonPrincipal.setAttribute("aria-expanded", "false");
      } else {
        botonPrincipal.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
