---
// Componente para select dinámico de vibes
// Genera opciones de vibe desde una configuración centralizada

import { VIBES } from "../../lib/vibes";

interface Props {
  name: string;
  id: string;
  required?: boolean;
  selectedValue?: string;
}

const { name, id, required = false, selectedValue } = Astro.props;
---

<select name={name} id={id} required={required}>
  {VIBES.map((vibe) => (
    <option value={vibe.value} selected={selectedValue === vibe.value}>
      {vibe.label}
    </option>
  ))}
</select>
