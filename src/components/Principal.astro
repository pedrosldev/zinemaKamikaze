                    value="0.3"
                />
                <span style="color: #FFD700; font-size: ${isSmallLandscape ? '0.5rem' : 'clamp(0.6rem, 1.8vw, 0.8rem)'}; font-family: 'Sigmar', sans-serif; white-space: nowrap;">
                    RÁPIDO
                </span>
            </div>
            <div style="display: flex; align-items: center; justify-content: center;">
                <span id="speedValueDisplay" style="color: #FFD700; font-family: 'Sigmar', sans-serif; font-size: ${isSmallLandscape ? '0.6rem' : 'clamp(0.8rem, 2.5vw, 1rem)'}; font-weight: bold; background: rgba(139, 69, 19, 0.8); padding: ${isSmallLandscape ? '2px 6px' : 'clamp(3px, 1vw, 5px) clamp(8px, 2vw, 12px)'}; border-radius: 8px; border: 2px solid #FFD700; line-height: 1; display: inline-block; text-shadow: 0 0 5px rgba(255, 215, 0, 0.5);">
                    1.0x
                </span>
            </div>
        </div>
    </div>
`;

            // BOTÓN DE CERRAR
            const closeButton = document.createElement("button");
            closeButton.textContent = "SALIR DEL CINE";
            closeButton.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: linear-gradient(135deg, #8B4513, #D4AF37);
                color: #000;
                border: none;
                padding: 12px 25px;
                border-radius: 25px;
                cursor: pointer;
                font-family: 'Sigmar', sans-serif;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 1px;
                transition: all 0.3s ease;
                z-index: 10001;
                box-shadow: 0 4px 15px rgba(255, 215, 0, 0.5);
                border: 2px solid #FFD700;
            `;

            // ENSAMBLAJE
            screenFrame.appendChild(flipbookImages);
            screenFrame.appendChild(flickerOverlay);
            
            cinemaScreen.appendChild(screenFrame);
            
            popupContent.appendChild(cinemaScreen);
            popupContent.appendChild(audienceOverlay); // Público POR ENCIMA
            popupContent.appendChild(controlsContainer);
            
            popupOverlay.appendChild(closeButton);
            popupOverlay.appendChild(popupContent);
            document.body.appendChild(popupOverlay);

            // AÑADIR ESTILOS CSS
            const style = document.createElement('style');
            style.textContent = `
                /* ANIMACIÓN DEL FLIPBOOK - Dinámica según número de imágenes */
                @keyframes fastFlipbook {
                    0% {
                        opacity: 1;
                        transform: scale(1);
                    }
                    12% {
                        opacity: 1;
                        transform: scale(1.02);
                    }
                    ${100 / imageSequence.length}% {
                        opacity: 0;
                        transform: scale(1);
                    }
                    100% {
                        opacity: 0;
                        transform: scale(1);
                    }
                }

                /* EFECTO DE PARPADEO */
                @keyframes projectorFlicker {
                    0%, 100% {
                        opacity: 0.7;
                    }
                    25% {
                        opacity: 0.5;
                    }
                    50% {
                        opacity: 0.8;
                    }
                    75% {
                        opacity: 0.6;
                    }
                }

                /* ESTILOS DEL SLIDER */
                #speedControlPopup::-webkit-slider-thumb {
                    -webkit-appearance: none;
                    width: 20px;
                    height: 20px;
                    background: #FFD700;
                    border-radius: 50%;
                    cursor: pointer;
                    border: 2px solid #8B4513;
                    box-shadow: 0 0 10px rgba(255, 215, 0, 0.8);
                    transition: all 0.2s ease;
                }
                #speedControlPopup::-webkit-slider-thumb:hover {
                    background: #FFFFFF;
                    transform: scale(1.2);
                    box-shadow: 0 0 15px rgba(255, 255, 255, 0.9);
                }
                #speedControlPopup::-moz-range-thumb {
                    width: 20px;
                    height: 20px;
                    background: #FFD700;
                    border-radius: 50%;
                    cursor: pointer;
                    border: 2px solid #8B4513;
                    box-shadow: 0 0 10px rgba(255, 215, 0, 0.8);
                }
            `;
            document.head.appendChild(style);

            // FUNCIONALIDAD DE CONTROLES
            const speedControlPopup = document.getElementById("speedControlPopup") as HTMLInputElement;
            const speedValuePopup = document.getElementById("speedValueDisplay") as HTMLSpanElement;
            const flipbookImagesPopup = flipbookImages.querySelectorAll("div") as NodeListOf<HTMLElement>;

            function updateSpeedPopup() {
                if (!speedControlPopup || !speedValuePopup || flipbookImagesPopup.length === 0) return;

                const speed = parseFloat(speedControlPopup.value);
                speedValuePopup.textContent = `${speed.toFixed(1)}x`;

                // Usar el número real de imágenes
                const totalImages = imageSequence.length;
                const frameDuration = 0.7; // segundos por frame
                const baseDuration = totalImages * frameDuration;
                const newDuration = baseDuration / speed;

                flipbookImagesPopup.forEach((img, index) => {
                    img.style.animationDuration = `${newDuration}s`;
                    const delayPerFrame = frameDuration / speed;
                    img.style.animationDelay = `${delayPerFrame * index}s`;
                });
            }

            if (speedControlPopup && speedValuePopup && flipbookImagesPopup.length > 0) {
                speedControlPopup.addEventListener("input", updateSpeedPopup);
                updateSpeedPopup();
            }

            // FUNCIONES DE CIERRE
            function closePopup() {
                document.body.removeChild(popupOverlay);
            }

            closeButton.addEventListener("click", closePopup);
            popupOverlay.addEventListener("click", function (e) {
                if (e.target === popupOverlay) {
                    closePopup();
                }
            });

            document.addEventListener("keydown", function closeOnEscape(e) {
                if (e.key === "Escape") {
                    closePopup();
                    document.removeEventListener("keydown", closeOnEscape);
                }
            });

            // EFECTOS HOVER
            closeButton.addEventListener("mouseenter", function() {
                this.style.background = "linear-gradient(135deg, #D4AF37, #FFD700)";
                this.style.transform = "scale(1.1)";
                this.style.boxShadow = "0 6px 20px rgba(255, 215, 0, 0.8)";
            });

            closeButton.addEventListener("mouseleave", function() {
                this.style.background = "linear-gradient(135deg, #8B4513, #D4AF37)";
                this.style.transform = "scale(1)";
                this.style.boxShadow = "0 4px 15px rgba(255, 215, 0, 0.5)";
            });
        });
    }
});


</script>
<script is:inline>
  // ========== MANEJO MODAL COMENTARIOS EXPECTATIVAS ==========
  
  function openExpectationCommentsModal() {
    const modal = document.getElementById('expectation-comments-modal');
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }
  
  function closeExpectationCommentsModal() {
    const modal = document.getElementById('expectation-comments-modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
  }
  
  // Cerrar modal con ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeExpectationCommentsModal();
    }
  });

  // Contador de caracteres
  const expectationTextarea = document.getElementById('expectation-comment-content');
  const expectationCharCount = document.getElementById('expectation-char-count');
  
  if (expectationTextarea && expectationCharCount) {
    expectationTextarea.addEventListener('input', () => {
      expectationCharCount.textContent = expectationTextarea.value.length;
    });
  }

  // Enviar comentario
  const expectationForm = document.getElementById('expectation-comment-form');
  const expectationFormMessage = document.getElementById('expectation-form-message');
  
  if (expectationForm) {
    expectationForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const filmId = document.getElementById('expectation-film-id').value;
      const authorName = document.getElementById('expectation-author-name').value;
      const content = document.getElementById('expectation-comment-content').value;
      
      expectationFormMessage.textContent = 'Enviando comentario...';
      expectationFormMessage.className = 'form-message info';
      
      try {
        const response = await fetch('/api/add-expectation-comment', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            film_id: filmId,
            author_name: authorName,
            content: content
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          expectationFormMessage.textContent = '✓ Comentario añadido. Recargando página...';
          expectationFormMessage.className = 'form-message success';
          
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          expectationFormMessage.textContent = '✗ ' + data.message;
          expectationFormMessage.className = 'form-message error';
        }
      } catch (error) {
        expectationFormMessage.textContent = '✗ Error al enviar el comentario. Inténtalo de nuevo.';
        expectationFormMessage.className = 'form-message error';
      }
    });
  }
</script>