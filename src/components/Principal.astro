---
import { getAllVibes, getLatestMovie, getExpectationCommentsByFilmId, getReviewedMovies } from "../lib/db";
import Vibrarcodion from "./Vibrarcodion.astro";
import TokenInput from "./TokenInput.astro";
import MoviePoster from "./MoviePoster.astro";
import ExpectationModal from "./ExpectationModal.astro";
import MovieSelector from "./MovieSelector.astro";
import ReviewedMoviesCarousel from "./ReviewedMoviesCarousel.astro";
import { moodSequences, defaultSequence } from "../config/moodSequences";

const vibes = await getAllVibes();
const latestMovie = await getLatestMovie();
const isViewingPeriod = latestMovie?.viewing_period ?? false;
const expectationMood: string | null = latestMovie?.expectation_mood || null;
const expectationComments = latestMovie && isViewingPeriod 
  ? await getExpectationCommentsByFilmId(latestMovie.film_id) 
  : [];

// Obtener películas revisadas para el carrusel (cuando no hay viewing period)
const reviewedMovies = !isViewingPeriod ? await getReviewedMovies() : [];

// Seleccionar la secuencia según el mood, o usar la secuencia por defecto
const currentSequence = expectationMood && moodSequences[expectationMood] 
  ? moodSequences[expectationMood] 
  : defaultSequence;
---

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/styles/Principal.css?v=2.2" />
  <link rel="stylesheet" href="/styles/MovieSelector.css?v=2.2" />
</head>

<main>
  <div class="a">
    <h1>ZINEMA KAMIKAZE!!!</h1>
    <a href="/catalog" class="catalog-link">
      <span>¿A QUÉ ME TENGO QUE ENFRENTAR?</span>
      <small>(listado de películas)</small>
    </a>
    <div class="film-grain"></div>
    <div class="old-film-scratches"></div>
  </div>

     {
      isViewingPeriod ? (
  <div class="b" id="flipbookTrigger">
    <small class="movie">Expectativas con el visionado</small>
    <small class="movie">(Haz click para abrir)</small>
    <!-- Datos invisibles para el flipbook -->
    <div id="flipbook-data" data-sequence={JSON.stringify(currentSequence)} style="display: none;"></div>
  </div>) : (
    <div class="b">
      {reviewedMovies.length > 0 ? (
        <ReviewedMoviesCarousel movies={reviewedMovies} />
      ) : (
        <div>Próximamente...</div>
      )}
    </div>
  )
    }



  <div class="c"><p>¿Qué es Zinemakamikaze?</p></div>

  <div class="d">
    {
      isViewingPeriod ? (
        <div class="viewing-period-info">
         
          <h3>PRÓXIMA CRÍTICA EN PROCESO</h3>
         
          <div class="movie-pointing-info">
            <h4>
              "{latestMovie?.title}" ({latestMovie?.year})
            </h4>
    
          </div>
          <div class="status-message">
            <em>La crítica estará disponible pronto...</em>
          </div>
        </div>
      ) : (
        <TokenInput />
      )
    }

    {
      !isViewingPeriod && (
        <h1
          class="findSurprise findSurprise-perforations findSurprise-sepia findSurprise-wide"
          id="btnLeer"
          style="display: none;"
        >
          Y LA ELEGIDA ES...
        </h1>
      )
    }
    <div id="contenido"></div>
        {isViewingPeriod && (
      <img src="/images/pointing_hand.png" alt="Pointing hand" class="pointing-hand" />
    )}
  </div>

<div 
  class="e surprise" 
  data-viewing-period={isViewingPeriod ? 'true' : 'false'}
  data-has-poster={isViewingPeriod && latestMovie?.poster_url ? 'true' : 'false'}
  style={isViewingPeriod && latestMovie?.poster_url ? `--poster-url: url(https://image.tmdb.org/t/p/w780${latestMovie.poster_url})` : ''}
>
  <MoviePoster
    isViewingPeriod={isViewingPeriod}
    latestMovie={latestMovie as { title: string; poster_url: string | null } | null}
    expectationCommentsCount={expectationComments.length}
  />
</div>

  <div class="f">
    <div class="film-grain"></div>
    <div class="old-film-scratches"></div>
    <Vibrarcodion vibes={vibes} />
  </div>
</main>

<!-- Modal de Comentarios de Expectativas (FUERA DEL GRID) -->
<ExpectationModal
  isViewingPeriod={isViewingPeriod}
  latestMovie={latestMovie as { title: string; film_id: number } | null}
  expectationComments={expectationComments}
/>

<!-- Selector de Películas (MODO TRIPLE CHOICE) -->
<MovieSelector movies={[]} token="" selectedBy="" />

<script>
  import { initTokenValidation } from '../scripts/tokenValidation';
  import { initAboutPopup } from '../scripts/aboutPopup';
  import { initFlipbook } from '../scripts/flipbook';
  import { initExpectationComments } from '../scripts/expectationComments';

  document.addEventListener("DOMContentLoaded", function () {
    // Inicializar todos los módulos
    initTokenValidation();
    initAboutPopup();
    initFlipbook();
    initExpectationComments();
  });
</script>
